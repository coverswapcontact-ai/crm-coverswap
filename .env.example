# ────────────────────────────────────────────────────────────
# CRM CoverSwap — variables d'environnement
# Copier vers .env.local en dev, ou configurer dans Railway
# ────────────────────────────────────────────────────────────

# Base de données (SQLite)
# Dev:  file:./dev.db
# Prod Railway (volume):  file:/data/crm.db
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_SECRET="CHANGE_ME_random_32_bytes_hex"
NEXTAUTH_URL="http://localhost:3001"

# Email (Resend)
RESEND_API_KEY="re_xxx"
EMAIL_FROM="CoverSwap <noreply@coverswap.fr>"

# IA (Anthropic)
ANTHROPIC_API_KEY="sk-ant-xxx"

# Webhook — DOIT correspondre à CRM_WEBHOOK_SECRET sur le site
WEBHOOK_SECRET="CHANGE_ME_same_as_site"
# Rotation sans coupure : l'ancien secret, accepté le temps de mettre à jour le site, n8n et Zapier, puis à retirer
WEBHOOK_SECRET_PRECEDENT=""

# Admin dashboard
ADMIN_PASSWORD="CHANGE_ME_strong_password"

# URL publique
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# ── Meta Lead Ads (réception directe) + API Conversions ────
# Marche à suivre complète : docs/META.md
#
# Réception des leads (obligatoire)
META_APP_SECRET=""              # clé secrète de l'app : signe chaque appel de Meta
META_VERIFY_TOKEN=""            # chaîne au hasard, recopiée dans l'app Meta à la déclaration du webhook
META_PAGE_ACCESS_TOKEN=""       # jeton de page longue durée : lit les réponses des formulaires
META_PAGE_ID=""                 # identifiant de la page : vérifie l'abonnement au champ leadgen
META_APP_ID=""                  # avec META_APP_SECRET : surveille l'échéance du jeton
# META_API_VERSION="v26.0"      # version de l'API Graph (v26.0 par défaut)

# Renvoi des conversions (recommandé : l'algorithme optimise alors sur les signatures)
META_PIXEL_ID=""                # identifiant du jeu de données (Gestionnaire d'événements)
META_CONVERSIONS_TOKEN=""       # jeton du jeu de données ; à défaut, META_PAGE_ACCESS_TOKEN est utilisé
# META_TEST_EVENT_CODE=""       # à poser le temps d'un essai : les événements arrivent dans « Événements de test »

# API publique des communes (code postal → ville). Par défaut https://geo.api.gouv.fr ;
# ne sert qu'aux essais à la remplacer.
# API_COMMUNES_URL=""

# ── Notifications immédiates (un lead Meta prévient le téléphone) ──
# Au moins deux canaux : sans quoi une panne du seul canal fait perdre un lead.
TELEGRAM_BOT_TOKEN=""           # bot créé avec @BotFather
TELEGRAM_CHAT_ID=""             # identifiant de la discussion (api.telegram.org/bot<jeton>/getUpdates)
NTFY_TOPIC=""                   # sujet ntfy.sh, à garder secret : quiconque le connaît peut écrire
# NTFY_SERVEUR="https://ntfy.sh"
# NTFY_TOKEN=""                 # si le serveur ntfy demande une authentification
LEAD_NOTIFICATION_EMAIL=""      # destinataire des mails (troisième canal, via RESEND_API_KEY)

# Tâches planifiées (/api/cron/*) : Authorization: Bearer <CRON_SECRET>.
# Sans cette variable, elles refusent tout appel.
CRON_SECRET=""

# ── Compte Google (miroir Drive, agent mail) ──────────────
# Identifiant OAuth « application web », redirection https://<CRM>/api/google/retour.
# GOOGLE_TOKEN_KEY : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_TOKEN_KEY=""
# Application publiée dans Google Cloud (plus en mode Test) : 1 éteint le rappel
# de reconnexion tous les 7 jours.
GOOGLE_APPLICATION_PUBLIEE=""

# ── Turso (production Vercel uniquement) ───────────────────
# TURSO_DATABASE_URL="libsql://xxx.turso.io"
# TURSO_AUTH_TOKEN=""

# ── Prospection (Google Places API New) ────────────────────
# Console Google Cloud → activer "Places API (New)" → créer une clé
GOOGLE_PLACES_API_KEY=""
