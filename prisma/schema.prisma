generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Lead {
  id               String            @id @default(cuid())
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  nom              String
  prenom           String
  email            String?
  telephone        String
  ville            String
  codePostal       String?
  source           String            @default("AUTRE")
  statut           String            @default("NOUVEAU")
  typeProjet       String            @default("CUISINE")
  referenceChoisie String?
  mlEstimes        Float?
  prixDevis        Float?
  lienSimulation   String?
  scoreSignature   Int               @default(0)
  notes            String?
  // Client pérenne auquel ce contact est rattaché (src/lib/clients)
  clientId         String?
  client           Client?           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  // Acquisition, en champs (avant : noyée dans `notes`)
  campagne         String?
  publicite        String?
  formulaire       String?
  metaLeadgenId    String?
  // Depuis le site (17/09/2026) : champs structurés au lieu de notes concaténées
  message          String? // ce que la personne a écrit dans le formulaire
  styleSouhaite    String? // style demandé (marbre blanc, chêne…)
  parcoursId       String? // identifiant du parcours navigateur : simulation puis devis = même fiche
  ipOrigine        String? // adresse IP du visiteur, pour la limite anti-abus du webhook
  vuLe             DateTime? // première ouverture de la fiche dans le CRM : sert à la relance des leads non traités
  // Priorité de rappel (src/lib/prospects/priorite.ts) : calculée à l'arrivée d'après
  // les réponses du formulaire et le code postal ; posée à la main, elle n'est plus recalculée.
  priorite         String? // PRIORITAIRE | STANDARD | SECONDAIRE | A_ECARTER
  prioriteMotif    String? // pourquoi, en une phrase lisible
  prioriteManuelle Boolean           @default(false)
  occupation       String? // PROPRIETAIRE | LOCATAIRE, d'après le formulaire
  delaiProjet      String? // COURT | MOYEN | LOINTAIN | INDETERMINE
  delaiProjetTexte String? // la réponse telle que donnée
  tailleCuisine    String? // la réponse telle que donnée
  rappelLe         DateTime? // prochain rappel téléphonique prévu (issue d'appel « à rappeler »)
  traiteLe         DateTime? // « marqué comme traité » depuis Leads : hors de la file d'appels, pas archivé ; un rappel posé l'y remet
  // Doublon probable (même nom, même ville, quelques jours d'écart, autre téléphone et autre e-mail) :
  // signalé, jamais fusionné seul — Lucas fusionne en un clic ou écarte le signalement.
  doublonDe        String? // contact déjà connu qui semble être la même personne
  doublonMotif     String? // pourquoi, en une phrase
  doublonTraiteLe  DateTime? // fusionné ou écarté
  metaLeads        MetaLead[]
  conversationsSms ConversationSms[]
  interactions     Interaction[]
  notesAppel       NoteAppel[]
  messages         Message[]
  devis            Devis[]
  chantier         Chantier?
  simulations      Simulation[]
  photos           PhotoLead[]
  dossiers         Dossier[]
  archiveLe        DateTime? // archivage : rien ne se supprime
  archiveMotif     String?
  ecriture         String? // contexte de la dernière écriture (auteur, jeton), lu par le journal

  @@index([clientId])
  @@index([parcoursId])
}

// Simulation faite sur le site AVANT toute coordonnée : rattachée à un parcours
// navigateur, puis à un lead quand la personne demande son devis. Sans demande
// sous 30 jours, les images sont effacées et la ligne archivée (politique de
// confidentialité du site).
model SimulationSite {
  id               String    @id @default(cuid())
  createdAt        DateTime  @default(now())
  parcoursId       String
  projet           String // cuisine | salle-de-bain | meubles | mur-plafond | professionnel
  references       String    @default("[]") // JSON { zone, libelle, ref, nom }[]
  referenceChoisie String?
  imageBeforePath  String?
  imageAfterPath   String?
  page             String? // page du site d'où vient la simulation
  source           String? // utm_source / medium, s'il y en a
  campagne         String?
  ipOrigine        String?
  dureeMs          Int? // temps de génération
  leadId           String? // renseigné au rattachement
  simulationId     String? // Simulation créée sur le lead au rattachement
  rattacheeLe      DateTime?
  archiveLe        DateTime? // purge : images effacées, ligne conservée sans image
  archiveMotif     String?
  ecriture         String?

  @@index([parcoursId])
  @@index([leadId])
  @@index([createdAt])
}

// Événement de parcours sur le site (simulation lancée, résultat vu, devis
// demandé…) : aucune donnée personnelle, un identifiant de parcours navigateur
// et la page. Lu par la synthèse (audience par source et par page).
model EvenementSite {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  parcoursId String
  type       String
  page       String?
  source     String?
  campagne   String?
  meta       String? // JSON libre, court (projet, référence, raison d'échec…)

  @@index([createdAt])
  @@index([type, createdAt])
}

// Ce que le CRM publie sur le site : une réalisation (photo après, éventuellement
// avant) ou un avis client, avec l'accord écrit de la personne. Le site ne lit
// que les lignes publiées (publieLe posé, retireLe vide) par /api/site/publications ;
// les photos sont servies par /api/site/photos/<id>, jamais par /api/uploads.
model PublicationSite {
  id             String    @id @default(cuid())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  type           String // REALISATION | AVIS
  titre          String
  texte          String? // légende de la réalisation ou texte de l'avis
  ville          String?
  typeProjet     String? // CUISINE | SDB | MEUBLES | PRO | AUTRE
  note           Int? // avis : 1 à 5
  auteur         String? // avis : prénom ou initiales, jamais le nom complet sans accord
  photoAvant     String? // chemin relatif au dossier des téléversements
  photoApres     String?
  dossierId      String?
  clientId       String?
  accordClientLe DateTime? // accord écrit de la personne pour la publication
  ordre          Int       @default(0)
  publieLe       DateTime?
  retireLe       DateTime?
  archiveLe      DateTime?
  archiveMotif   String?
  ecriture       String?

  @@index([type, publieLe])
  @@index([dossierId])
}

// Photo jointe par la personne à sa demande (formulaire de devis du site) :
// un fichier sous le dossier des téléversements, jamais accessible sans session.
model PhotoLead {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  leadId       String
  lead         Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  chemin       String // relatif au dossier des téléversements
  origine      String    @default("FORMULAIRE_SITE")
  dossierId    String? // dossier où cette photo a été recopiée à l'ouverture
  rangeeLe     DateTime?
  archiveLe    DateTime? // archivage : rien ne se supprime
  archiveMotif String?
  ecriture     String? // contexte de la dernière écriture (auteur, jeton), lu par le journal

  @@index([leadId])
}

/// Un formulaire Meta Lead Ads rempli : l'événement reçu du webhook, puis ce que
/// l'API Graph en dit. Gardé même quand la récupération échoue : un lead qui
/// échoue doit rester visible (écran Publicité) et rejouable, jamais perdu.
model MetaLead {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  leadgenId     String    @unique // identifiant Meta : la clé d'idempotence, sert aussi au renvoi des conversions
  pageId        String?
  formId        String?
  formNom       String?
  campagneId    String?
  campagneNom   String? // nom lisible, pas seulement l'identifiant
  adsetId       String?
  adsetNom      String?
  adId          String?
  adNom         String?
  plateforme    String? // facebook | instagram
  organique     Boolean   @default(false) // formulaire organique (pas une publicité payante)
  soumisLe      DateTime // horodatage réel de la soumission (created_time de Meta)
  recuLe        DateTime  @default(now()) // horodatage de réception du webhook
  traiteLe      DateTime?
  statut        String    @default("RECU") // RECU | TRAITE | ECHEC
  erreur        String?
  tentatives    Int       @default(0)
  reponses      String? // JSON : toutes les réponses du formulaire, questions personnalisées comprises
  // Compte rendu du dernier envoi de notification : une ligne par canal, même
  // non configuré. C'est ce qui rend visible un push qui n'est jamais parti.
  notifications String? // JSON : [{canal, ok, configure, detail}]
  notifieLe     DateTime? // au moins un canal a abouti
  pousseLe      DateTime? // au moins un canal POUSSÉ (Telegram/ntfy) a abouti
  // Pas unique : la même personne peut remplir deux formulaires, ses deux leads
  // Meta se rattachent alors au même contact.
  leadId        String?
  lead          Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  archiveLe     DateTime? // archivage : rien ne se supprime
  archiveMotif  String?
  ecriture      String? // contexte de la dernière écriture (auteur, jeton), lu par le journal

  @@index([statut, recuLe])
  @@index([leadId])
}

model Simulation {
  id                String    @id @default(cuid())
  createdAt         DateTime  @default(now())
  leadId            String
  lead              Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  source            String    @default("SITE_SIMULATEUR")
  referenceChoisie  String?
  mlEstimes         Float?
  prixDevis         Float?
  lienSimulation    String?
  imageBeforePath   String?
  imageAfterPath    String?
  imageOriginalPath String?
  notes             String?
  dossierId         String? // dossier où la photo avant et le rendu ont été rangés (photos de chantier, donc Drive)
  rangeeLe          DateTime?
  photosDossier     String? // JSON { avant, rendu } : identifiants des copies dans les photos du dossier (le rendu n'est pas une photo du client)
  archiveLe         DateTime? // archivage : rien ne se supprime
  archiveMotif      String?
  ecriture          String? // contexte de la dernière écriture (auteur, jeton), lu par le journal
}

model Interaction {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  type         String
  contenu      String
  leadId       String
  lead         Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  archiveLe    DateTime? // archivage : rien ne se supprime
  archiveMotif String?
  ecriture     String? // contexte de la dernière écriture (auteur, jeton), lu par le journal
}

model Devis {
  id                   String   @id @default(cuid())
  numero               String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  expiresAt            DateTime
  statut               String   @default("BROUILLON")
  reference            String // code libre ex "K1"
  nomReference         String? // nom commercial ex "Black mat"
  gamme                String   @default("ESSENTIAL") // GammeCode
  complexite           Int      @default(1) // 1=standard, 2=+10%, 3=+20%
  mlTotal              Float
  prixVenteHTml        Float    @default(0) // prix vente unitaire HT/ml
  prixMatiere          Float // coût matière TTC réel (pour marge interne)
  prixVente            Float // total vente client (= TTC pour CoverSwap 293B)
  margeNette           Float
  fraisDeplacement     Float    @default(0)
  acompte30            Float
  solde70              Float
  objet                String? // "Rénovation par covering meuble coiffeur"
  lignesAdditionnelles String   @default("[]") // JSON LigneAdditionnelle[]
  notesInternes        String?
  leadId               String
  lead                 Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  facture              Facture?
  ecriture             String? // contexte de la dernière écriture (auteur, jeton), lu par le journal
}

model Facture {
  id           String    @id @default(cuid())
  numero       String    @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  statut       String    @default("ACOMPTE_EN_ATTENTE")
  montantTotal Float
  acompteRecu  Boolean   @default(false)
  acompteDate  DateTime?
  soldeRecu    Boolean   @default(false)
  soldeDate    DateTime?
  devisId      String    @unique
  devis        Devis     @relation(fields: [devisId], references: [id], onDelete: Cascade)
  ecriture     String? // contexte de la dernière écriture (auteur, jeton), lu par le journal
}

model Chantier {
  id               String     @id @default(cuid())
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  dateIntervention DateTime
  adresse          String
  reference        String
  mlCommandes      Float
  prixMatiere      Float
  margeNette       Float
  statut           String     @default("COMMANDE_PASSEE")
  acompteRecu      Boolean    @default(false)
  soldeRecu        Boolean    @default(false)
  photosAvant      String     @default("[]")
  photosApres      String     @default("[]")
  leadId           String     @unique
  lead             Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  commandes        Commande[]
  archiveLe        DateTime? // archivage : rien ne se supprime
  archiveMotif     String?
  ecriture         String? // contexte de la dernière écriture (auteur, jeton), lu par le journal
}

model Commande {
  id                   String    @id @default(cuid())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  reference            String
  quantiteML           Float
  prixMatiere          Float
  fournisseur          String    @default("Tego France")
  emailFournisseur     String    @default("France@tego.eu")
  statut               String    @default("A_COMMANDER")
  dateCommande         DateTime?
  dateReceptionEstimee DateTime?
  dateReceptionReelle  DateTime?
  chantierId           String
  chantier             Chantier  @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  archiveLe            DateTime? // archivage : rien ne se supprime
  archiveMotif         String?
  ecriture             String? // contexte de la dernière écriture (auteur, jeton), lu par le journal
}

model Objectif {
  id              String    @id @default(cuid())
  periode         String    @unique
  caMensuel       Float
  nombreChantiers Int
  tauxConversion  Float
  createdAt       DateTime  @default(now())
  archiveLe       DateTime? // archivage : rien ne se supprime
  archiveMotif    String?
  ecriture        String? // contexte de la dernière écriture (auteur, jeton), lu par le journal
}

// ─────────────────────────────────────────────
// Module Prospection (agent IA B2B hôtels/restaurants)
// SQLite : pas d'enum ni de Json natifs — valeurs et structures
// documentées en commentaire, types TS dans src/lib/prospection/constants.ts
// ─────────────────────────────────────────────

model AgentProfile {
  id           String     @id @default(cuid())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  slug         String     @unique // "hotels" | "restaurants"
  nom          String
  actif        Boolean    @default(true)
  config       String     @default("{}") // JSON AgentProfileConfig : typesGooglePlaces, motsClesSignaux, blacklistMarques, angleVente, quotaJournalier
  prospects    Prospect[]
  archiveLe    DateTime? // archivage : rien ne se supprime
  archiveMotif String?
  ecriture     String? // contexte de la dernière écriture (auteur, jeton), lu par le journal
}

model Prospect {
  id              String             @id @default(cuid())
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  agentProfileId  String
  agentProfile    AgentProfile       @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  googlePlaceId   String             @unique
  nom             String
  adresse         String?
  ville           String?
  codePostal      String?
  telephone       String?
  siteWeb         String?
  email           String?
  emailType       String             @default("INCONNU") // EmailType : GENERIQUE | NOMINATIF | INCONNU
  noteGoogle      Float?
  nbAvis          Int?
  siret           String?
  anneeCreation   Int?
  statut          String             @default("SOURCE") // StatutProspect : SOURCE | QUALIFIE | ECARTE | CONTACTE | RELANCE | REPONDU | RDV | CLIENT | OPT_OUT
  score           Int                @default(0)
  scoreDetails    String? // JSON : décomposition du score par signal
  signalPrincipal String? // citation d'avis ou fait saillant détecté
  angleSuggere    String? // angle d'approche proposé pour l'email
  avisBruts       String? // JSON AvisBrut[] : avis Google bruts (servira au scoring étape 3)
  fermetureHebdo  String? // jour(s) de fermeture hebdo ex. "lundi" ou "dimanche, lundi" — null si 7j/7 ou inconnu
  optOut          Boolean            @default(false)
  optOutAt        DateTime?
  clientId        String? // client pérenne, à la conversion seulement
  client          Client?            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  emailDrafts     EmailDraft[]
  activites       ProspectActivity[]
  dossiers        Dossier[]
  archiveLe       DateTime? // archivage : rien ne se supprime
  archiveMotif    String?
  ecriture        String? // contexte de la dernière écriture (auteur, jeton), lu par le journal

  @@index([agentProfileId, statut])
  @@index([score])
}

model EmailDraft {
  id               String    @id @default(cuid())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  prospectId       String
  prospect         Prospect  @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  sequencePosition Int       @default(1) // 1=initial, 2=relance1, 3=relance2
  sujet            String
  corps            String
  statut           String    @default("BROUILLON") // StatutEmailDraft : BROUILLON | VALIDE | EDITE | REJETE | ENVOYE
  corpsOriginal    String? // version IA avant édition humaine (boucle de feedback)
  envoyeAt         DateTime?
  ouvertAt         DateTime?
  reponduAt        DateTime?
  archiveLe        DateTime? // archivage : rien ne se supprime
  archiveMotif     String?
  ecriture         String? // contexte de la dernière écriture (auteur, jeton), lu par le journal

  @@index([statut])
}

model ProspectActivity {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  type       String // TypeActivite : SOURCING | SCORING | DRAFT_CREE | VALIDATION | EDITION | ENVOI | OUVERTURE | REPONSE | OPT_OUT | NOTE
  details    String? // JSON : payload libre selon le type d'activité
  ecriture   String? // contexte de la dernière écriture (auteur, jeton), lu par le journal

  @@index([prospectId, createdAt])
}

// ─────────────────────────────────────────────
// Module Dossiers en cours (/dossiers)
// Un dossier = une affaire réelle, créée à la conversion (photos + coordonnées
// complètes + objet). Valeurs des champs String et structures JSON documentées
// dans src/lib/dossiers/constants.ts (SQLite : pas d'enum ni de Json natifs).
// ─────────────────────────────────────────────

model Dossier {
  id                     String             @id @default(cuid())
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  leadId                 String? // Lead B2C d'origine (Meta Ads, site, simulateur)
  lead                   Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)
  prospectId             String? // Prospect B2B d'origine (/prospection)
  prospect               Prospect?          @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  clientId               String? // client pérenne ; les champs client* restent les coordonnées de ce chantier
  client                 Client?            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  clientNom              String
  clientAdresse          String
  clientCp               String
  clientVille            String
  clientEmail            String?
  clientTelephone        String
  objet                  String // ex. "Recouvrement façades de cuisine"
  etape                  String             @default("QUALIFICATION") // EtapeDossier
  ouvertLe               DateTime? // date réelle d'ouverture (dossier repris d'avant le CRM) ; null = createdAt
  montantEstime          Float?
  source                 String // SourceDossier : PROSPECTION | RECOMMANDATION | SOUS_TRAITANCE | ENTRANT | AUTRE | INCONNUE
  motifPerte             String? // MotifPerte, demandé à l'entrée en PERDU (signalé s'il manque)
  // Perte : figée au moment où le dossier passe en PERDU (retirée à la reprise ;
  // l'événement de changement d'étape la garde pour toujours).
  perteLe                DateTime?
  perteEtape             String? // étape active quittée
  perteConcurrent        String? // qui a remporté le marché, si on le sait
  perteMontantConcurrent Float? // son prix, si on le sait
  perteMontantPropose    Float? // notre dernier prix (dernier devis émis, sinon estimation)
  perteCommentaire       String?
  prochaineAction        String?
  prochaineActionDate    DateTime?
  dateChantier           DateTime? // attendue à partir de PLANIFIE (signalée si elle manque)
  // Mission 10 (23/09/2026) : ce que l'assistant modifie à la voix, tracé champ par champ (ModificationDossier).
  dateSouhaitee          DateTime? // date de chantier souhaitée par le client
  dateFinChantier        DateTime? // fin du chantier, quand il dure plusieurs jours
  teintes                String? // JSON { "CUISINE.ilot": "chêne" } : la teinte retenue par sous-partie, en mots (Familles du projet)
  modifications          ModificationDossier[]
  messagesEspace         MessageEspace[]
  photos                 String             @default("[]") // JSON string[] : chemins relatifs au répertoire d'upload
  // Mission 5 (22/09/2026) : familles et sous-parties du projet (src/lib/prestations), écrites par le client
  // dans son onglet Projet ou par Lucas ; JSON { CUISINE: ["facades-hautes", …], SDB: [] }.
  prestations            String?
  prestationsLe          DateTime?
  prestationsPar         String? // CLIENT | LUCAS | REPRISE
  // Mission 6 (22/09/2026) : qui a la main, UNE règle (src/lib/dossiers/main.ts), recalculée après chaque geste
  // (publication, devis, lien, geste du client, changement d'étape) ; null = jamais calculée (règle de l'étape).
  main                   String? // MOI | CLIENT
  mainLe                 DateTime? // depuis quand
  mainMotif              String? // pourquoi, en une phrase (« Simulation publiée : en attente de son retour »)
  completudeMasquee      String? // JSON [{ code, le }] : points « à compléter » masqués par Lucas pour ce dossier
  notes                  DossierNote[]
  evenements             DossierEvenement[]
  documents              Document[]
  encaissements          Encaissement[]
  depenses               Depense[]
  messages               Message[]
  espaces                EspaceClient[]
  accords                AccordDevis[]
  archiveLe              DateTime? // archivage : rien ne se supprime
  archiveMotif           String?
  ecriture               String? // contexte de la dernière écriture (auteur, jeton), lu par le journal

  @@index([etape])
  @@index([prochaineActionDate])
  @@index([clientId])
}

model DossierNote {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  dossierId    String
  dossier      Dossier   @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  etape        String // étape à laquelle la note se rattache
  contenu      String
  archiveLe    DateTime? // archivage : rien ne se supprime
  archiveMotif String?
  ecriture     String? // contexte de la dernière écriture (auteur, jeton), lu par le journal

  @@index([dossierId, etape])
}

model DossierEvenement {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  dossierId    String
  dossier      Dossier   @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  type         String // TypeEvenement : MAIL_RECU | MAIL_ENVOYE | WHATSAPP_RECU | WHATSAPP_ENVOYE | APPEL | DEVIS_GENERE | DEVIS_ENVOYE | FACTURE_GENEREE | CHANGEMENT_ETAPE | NOTE_AJOUTEE
  direction    String // ENTRANT | SORTANT | INTERNE
  contenu      String
  metadata     String    @default("{}") // JSON libre selon le type (ex. { de, vers } pour un changement d'étape)
  survenuLe    DateTime? // date réelle de l'événement quand elle diffère de sa saisie (corrigée, reprise) ; null = createdAt
  archiveLe    DateTime? // archivage : un mail rattaché au mauvais dossier en sort sans disparaître
  archiveMotif String?
  ecriture     String? // contexte de la dernière écriture (auteur, jeton), lu par le journal

  @@index([dossierId, createdAt])
}

model Document {
  id                String     @id @default(cuid())
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  dossierId         String
  dossier           Dossier    @relation(fields: [dossierId], references: [id], onDelete: Restrict)
  type              String // TypeDocument : DEVIS | FACTURE | AVOIR
  numero            String? // attribué à la génération, jamais réutilisé (voir NUMEROTATION) ; null tant que BROUILLON
  dateEmission      DateTime? // fixée à la génération, avec le numéro
  objet             String
  lignes            String // JSON LigneDocument[] : prestations et lignes de section
  totalHt           Float
  acomptePct        Int? // 30 par défaut sur un devis, null sur une facture
  noteMl            Boolean    @default(true)
  pdfPath           String?
  statut            String     @default("BROUILLON") // StatutDocument : BROUILLON | GENERE | ENVOYE | ACCEPTE | REFUSE | REMPLACE | ANNULEE
  origine           String     @default("CRM") // CRM : généré ici, figé à l'émission | REPRISE : émis avant le CRM, rattaché avec son numéro du registre
  // Mission 11 (25/09/2026) : plusieurs devis par dossier — un libellé de variante libre, une visibilité dans l'espace client.
  libelleVariante   String? // « façades seules », « façades + plan de travail »
  visibleEspace     Boolean    @default(true) // le client le voit dans son espace (un devis non retenu reste en historique)
  // Figé à l'émission : un document émis ne se modifie plus (la base le refuse).
  clientId          String? // client pérenne (suit les fusions)
  client            Client?    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  destinataire      String? // JSON : nom, adresse, code postal, ville, catégorie, SIRET, tels qu'imprimés
  categorieClient   String? // PARTICULIER | PROFESSIONNEL | DONNEUR_ORDRE au jour de l'émission
  mentions          String? // JSON string[] : mentions légales imprimées ; null = émis avant le gel des mentions
  echeanceLe        DateTime? // facture : échéance imprimée
  documentOrigineId String? // avoir : facture annulée ; devis refait : devis remplacé
  documentOrigine   Document?  @relation("DocumentsLies", fields: [documentOrigineId], references: [id], onDelete: Restrict)
  documentsLies     Document[] @relation("DocumentsLies")
  motifAvoir        String? // avoir : pourquoi la facture est annulée
  archiveLe         DateTime? // archivage : rien ne se supprime
  archiveMotif      String?
  ecriture          String? // contexte de la dernière écriture (auteur, jeton), lu par le journal

  @@unique([type, numero])
  @@index([dossierId])
  @@index([clientId])
}

model CompteurNumerotation {
  serie    String // compteur (voir NUMEROTATION) : DEVIS | FACTURE
  annee    Int
  valeur   Int // dernier numéro attribué
  ecriture String? // contexte de la dernière écriture (auteur, jeton), lu par le journal

  @@id([serie, annee])
}

model PresetTarif {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  designation  String
  unite        String // ml | jour | forfait
  prixUnitaire Float? // null = à saisir à chaque devis (carburant, péage, mission)
  // Sous-parties des prestations (src/lib/prestations) que ce tarif chiffre dans le devis prérempli :
  // JSON ["CUISINE.facades-hautes", …] ; sans rien, le devis cherche un tarif par mots-clés.
  prestations  String?
  ordre        Int       @default(0)
  actif        Boolean   @default(true)
  archiveLe    DateTime? // archivage : rien ne se supprime
  archiveMotif String?
  ecriture     String? // contexte de la dernière écriture (auteur, jeton), lu par le journal
}

// ─────────────────────────────────────────────
// Journal des modifications (traçabilité intégrale)
// Alimenté uniquement par des déclencheurs SQLite générés depuis ce schéma
// (src/lib/journal/declencheurs.ts) : aucune écriture ne peut lui échapper.
// Ni modifiable (sauf caviardage RGPD) ni supprimable.
// ─────────────────────────────────────────────

model JournalModification {
  id               String    @id
  horodatage       DateTime
  modele           String // nom du modèle Prisma
  enregistrementId String
  operation        String // ETAT_INITIAL | CREATION | MODIFICATION | ARCHIVAGE | RESTAURATION
  acteur           String // TYPE:identifiant (voir src/lib/journal/contexte.ts) : HUMAIN, AGENT, SYSTEME, EXTERNE, SCRIPT, MIGRATION, INCONNU
  jeton            String? // identifiant de l'écriture logique (partagé par ses écritures imbriquées)
  origine          String? // route ou tâche à l'origine de l'écriture
  requete          String? // identifiant de la requête HTTP ou de la tâche : regroupe les écritures d'un même geste
  avant            String? // JSON de l'enregistrement avant (null pour une création)
  apres            String // JSON de l'enregistrement après
  caviardeLe       DateTime? // anonymisation RGPD : contenu remplacé, la trace de l'écriture reste

  @@index([modele, enregistrementId, horodatage])
  @@index([horodatage])
  @@index([acteur])
  @@index([requete])
}

// Migrations de données exécutées au démarrage (idempotentes, une seule fois chacune).
model MigrationDonnees {
  nom        String   @id
  executeeLe DateTime
  dureeMs    Int
  resume     String // JSON : compteurs de la migration
  ecriture   String? // contexte de la dernière écriture (auteur, jeton), lu par le journal
}

// ─────────────────────────────────────────────
// File de tâches de fond (src/lib/taches)
// Travail asynchrone et rejouable : miroir Drive, envois validés, relève des
// mails… Jamais dans le chemin d'une requête : l'interface ne l'attend pas.
// Hors journal (mécanique interne) ; ses effets, eux, sont journalisés.
// ─────────────────────────────────────────────

model Tache {
  id              String    @id @default(cuid())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  type            String // TypeTache (src/lib/taches/registre.ts)
  cle             String    @unique // idempotence : deux mises en file de la même clé = une seule tâche
  charge          String    @default("{}") // JSON : paramètres de la tâche
  statut          String    @default("EN_ATTENTE") // EN_ATTENTE | EN_COURS | TERMINEE | ECHEC_DEFINITIF | ANNULEE
  priorite        Int       @default(0) // plus grand = plus urgent
  tentatives      Int       @default(0)
  tentativesMax   Int       @default(8)
  prochainEssaiLe DateTime  @default(now())
  verrouJusqua    DateTime? // bail d'exécution : passé ce délai, une tâche EN_COURS est reprise
  aRejouer        Boolean   @default(false) // remise en file pendant son exécution : rejouer une fois finie
  commenceLe      DateTime?
  termineLe       DateTime?
  derniereErreur  String?
  resultat        String? // JSON rendu par le traitement
  demandeePar     String // acteur qui a mis la tâche en file
  ecriture        String? // contexte de la dernière écriture (auteur, jeton), lu par le journal

  @@index([statut, prochainEssaiLe])
  @@index([type, statut])
}

// Travaux périodiques (relève des mails, vérification du miroir, alertes…) :
// une ligne par travail, son dernier passage et ses échecs consécutifs.
model Planification {
  nom               String    @id
  actif             Boolean   @default(true)
  dernierDebut      DateTime?
  dernierFin        DateTime?
  dernierStatut     String? // SUCCES | ECHEC | IGNORE
  derniereErreur    String?
  echecsConsecutifs Int       @default(0)
  prochainPassage   DateTime  @default(now())
  ecriture          String? // contexte de la dernière écriture (auteur, jeton), lu par le journal
}

// ─────────────────────────────────────────────
// Validation : « l'agent propose, je valide » (src/lib/validation)
// Toute action proposée par un agent ou par le système (rattacher un mail,
// changer une étape, envoyer un devis, fusionner deux clients…) passe par une
// proposition. Rien de ce qui engage de l'argent ou part chez un client ne
// s'exécute sans décision humaine.
// ─────────────────────────────────────────────

model Proposition {
  id               String    @id @default(cuid())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  type             String // TypeProposition (src/lib/validation/types.ts)
  statut           String    @default("EN_ATTENTE") // EN_ATTENTE | VALIDEE (exécution en file) | EXECUTEE | ECHEC | REJETEE | EXPIREE | ANNULEE | AUTOMATIQUE
  auteur           String // acteur qui propose : AGENT:mail, SYSTEME:doublons, SYSTEME:relances…
  titre            String // une phrase lisible : « Rattacher le mail de M. Durand au dossier Cuisine Pérols »
  resume           String? // détail lisible
  raisonnement     String? // pourquoi : conservé tel que formulé par l'agent
  confiance        Float? // 0 à 1, calculée par le code (jamais déclarée par le modèle seul)
  contenu          String // JSON : la proposition telle que faite, jamais modifiée
  contenuValide    String? // JSON : ce qui a été exécuté (la version modifiée, le cas échéant)
  modifiee         Boolean   @default(false) // la personne a corrigé la proposition avant de la valider
  cleUnicite       String?   @unique // une même chose n'est proposée qu'une fois, rejetée ou non
  clientId         String?
  dossierId        String?
  messageId        String?
  expireLe         DateTime?
  decideLe         DateTime?
  decidePar        String? // HUMAIN:email, ou l'acteur d'une exécution automatique autorisée
  motifRejet       String? // code de MOTIFS_REJET
  commentaireRejet String?
  executeLe        DateTime?
  resultat         String? // JSON rendu par l'exécution
  erreurExecution  String?
  archiveLe        DateTime? // archivage : rien ne se supprime
  archiveMotif     String?
  ecriture         String? // contexte de la dernière écriture (auteur, jeton), lu par le journal

  @@index([statut, type])
  @@index([dossierId])
  @@index([clientId])
  @@index([messageId])
}

// ─────────────────────────────────────────────
// Clients pérennes (src/lib/clients)
// Une personne ou une entreprise, au-delà d'un lead ou d'un dossier : son
// historique, ses dossiers, d'où elle vient, qui l'a recommandée.
// ─────────────────────────────────────────────

model Client {
  id                 String             @id @default(cuid())
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  categorie          String             @default("PARTICULIER") // CategorieClient : PARTICULIER | PROFESSIONNEL | DONNEUR_ORDRE
  nom                String // nom d'affichage : « Alice Durand », « Hôtel du Parc »
  prenom             String?
  nomFamille         String?
  raisonSociale      String?
  siret              String?
  adresse            String?
  codePostal         String?
  ville              String?
  // Acquisition : d'où vient le client (posée au premier contact, corrigeable)
  source             String // SourceClient (src/lib/clients/constantes.ts)
  sourceDetail       String? // précision : « salon Habitat », « Instagram »…
  campagne           String?
  publicite          String?
  formulaire         String?
  premierContactLe   DateTime
  recommandeParId    String?
  recommandePar      Client?            @relation("Recommandations", fields: [recommandeParId], references: [id], onDelete: Restrict)
  recommandations    Client[]           @relation("Recommandations")
  recommandeParTexte String? // recommandé par quelqu'un qui n'est pas (encore) client
  fusionneDansId     String? // absorbé par une fusion validée : le client conservé
  notes              String? // passif, contexte durable
  anonymiseLe        DateTime? // RGPD : identité retirée, données comptables conservées
  emails             ClientEmail[]
  telephones         ClientTelephone[]
  consentements      ConsentementMail[]
  leads              Lead[]
  prospects          Prospect[]
  dossiers           Dossier[]
  messages           Message[]
  documents          Document[]
  encaissements      Encaissement[]
  espacePermanent    EspacePermanent?
  archiveLe          DateTime? // archivage : rien ne se supprime
  archiveMotif       String?
  ecriture           String? // contexte de la dernière écriture (auteur, jeton), lu par le journal
  ConversationSms    ConversationSms[]

  @@index([nom])
  @@index([source])
  @@index([recommandeParId])
}

model ClientEmail {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  clientId     String
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  adresse      String // minuscules, sans espaces
  libelle      String? // « pro », « perso », « comptabilité »…
  principale   Boolean   @default(false)
  archiveLe    DateTime? // archivage : rien ne se supprime
  archiveMotif String?
  ecriture     String? // contexte de la dernière écriture (auteur, jeton), lu par le journal

  @@index([adresse])
  @@index([clientId])
}

model ClientTelephone {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  clientId     String
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  numero       String // normalisé : +33612345678
  saisi        String // tel que reçu ou saisi
  libelle      String?
  principal    Boolean   @default(false)
  archiveLe    DateTime? // archivage : rien ne se supprime
  archiveMotif String?
  ecriture     String? // contexte de la dernière écriture (auteur, jeton), lu par le journal

  @@index([numero])
  @@index([clientId])
}

// Consentement aux mails commerciaux : une ligne par déclaration, jamais
// modifiée (la base le refuse). L'état courant est la ligne la plus récente.
model ConsentementMail {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  statut      String // ACCORDE | REFUSE | RETIRE
  recueilliLe DateTime // date où la personne a donné ou retiré son accord
  moyen       String // FORMULAIRE_SITE | META_ADS | ORAL | ECRIT | EMAIL | AUTRE
  preuve      String? // texte de la case cochée, référence du formulaire, du mail…
  ecriture    String? // contexte de la dernière écriture (auteur, jeton), lu par le journal

  @@index([clientId, recueilliLe])
}

// ─────────────────────────────────────────────
// Paramètres datés (src/lib/parametres) : seuils, taux, règles. Aucune valeur
// par défaut dans le code ; chaque saisie est une ligne, jamais modifiée, avec
// sa date d'effet et sa source. La valeur d'une date est la plus récente
// saisie dont la date d'effet est passée.
// ─────────────────────────────────────────────

model Parametre {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  cle       String // CleParametre (src/lib/parametres/definitions.ts)
  valeur    String // JSON : nombre ou texte
  valableDu DateTime
  source    String? // d'où vient la valeur : « URSSAF 2026 », « comptable, mail du 12/09 »
  ecriture  String? // contexte de la dernière écriture (auteur, jeton), lu par le journal

  @@index([cle, valableDu])
}

// ─────────────────────────────────────────────
// Registre des numéros (src/lib/dossiers/numerotation.ts)
// Tout numéro de devis, de facture ou d'avoir émis, où que ce soit (numérotation
// manuelle, ancien écran, module Dossiers), y a sa ligne : un numéro inscrit
// n'est jamais réattribué. Lignes jamais supprimées ; seuls les compléments
// (type, destinataire, montant, note, document lié) peuvent être renseignés.
// ─────────────────────────────────────────────

model NumeroDocument {
  id           String                    @id @default(cuid())
  createdAt    DateTime                  @default(now())
  cle          String                    @unique // famille:année:rang, ex. « F:2026:12 », « :2026:38 »
  numero       String // tel qu'imprimé
  famille      String // préfixe : "" (série 2026 partagée puis devis), "F" (factures et avoirs), "FACT" (ancien écran)
  annee        Int
  rang         Int
  type         String // DEVIS | FACTURE | AVOIR | INCONNU
  origine      String // CRM | ANCIEN_CRM | MANUEL
  documentId   String?                   @unique
  emisLe       DateTime?
  destinataire String?
  montant      Float?
  note         String?
  affectations AffectationEncaissement[]
  ecriture     String? // contexte de la dernière écriture (auteur, jeton), lu par le journal

  @@index([famille, annee, rang])
}

// Argent reçu. Ne se supprime ni ne se modifie : s'annule (erreur de saisie) ou
// se rejette (chèque impayé), daté et motivé (la base le refuse autrement).
model Encaissement {
  id           String                    @id @default(cuid())
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  clientId     String? // payeur, client pérenne (suit les fusions)
  client       Client?                   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  dossierId    String? // chantier concerné ; null pour une facture hors CRM
  dossier      Dossier?                  @relation(fields: [dossierId], references: [id], onDelete: Restrict)
  payeur       String // nom du payeur tel que saisi
  montant      Float // euros, strictement positif
  moyen        String? // MoyenPaiement : VIREMENT | CHEQUE | ESPECES | CARTE | AUTRE ; null = non renseigné (reprise)
  reference    String? // n° de chèque, libellé du virement
  recuLe       DateTime // réception : virement arrivé, chèque ou espèces remis
  crediteLe    DateTime? // chèque : crédit sur le compte
  statut       String                    @default("VALIDE") // VALIDE | REJETE | ANNULE
  finLe        DateTime? // date du rejet ou de l'annulation
  motifFin     String?
  origine      String                    @default("SAISIE") // SAISIE | REPRISE_ANCIEN_ECRAN
  cleReprise   String?                   @unique // idempotence d'une reprise
  note         String?
  affectations AffectationEncaissement[]
  ecriture     String? // contexte de la dernière écriture (auteur, jeton), lu par le journal

  @@index([recuLe])
  @@index([dossierId])
  @@index([clientId])
  @@index([statut])
}

// Part d'un encaissement imputée sur une pièce du registre : devis (acompte) ou
// facture (du CRM, manuelle, de l'ancien écran). Ne se modifie pas : cesse de
// compter (TRANSFEREE sur la facture, LIBEREE) et une nouvelle la remplace.
model AffectationEncaissement {
  id               String         @id @default(cuid())
  createdAt        DateTime       @default(now())
  encaissementId   String
  encaissement     Encaissement   @relation(fields: [encaissementId], references: [id], onDelete: Restrict)
  numeroDocumentId String
  numeroDocument   NumeroDocument @relation(fields: [numeroDocumentId], references: [id], onDelete: Restrict)
  montant          Float
  statut           String         @default("ACTIVE") // ACTIVE | TRANSFEREE | LIBEREE
  finLe            DateTime?
  motifFin         String?
  ecriture         String? // contexte de la dernière écriture (auteur, jeton), lu par le journal

  @@index([encaissementId])
  @@index([numeroDocumentId, statut])
}

// Fichier conservé sur le volume (justificatif de dépense…) : jamais supprimé,
// archivé avec son motif ; l'empreinte reconnaît un même fichier envoyé deux fois.
model Fichier {
  id           String         @id @default(cuid())
  createdAt    DateTime       @default(now())
  chemin       String // relatif au répertoire d'upload
  nomOriginal  String?
  typeMime     String
  taille       Int
  empreinte    String // SHA-256 du contenu
  archiveLe    DateTime?
  archiveMotif String?
  depenses     Depense[]
  pieces       PieceMessage[]
  ecriture     String? // contexte de la dernière écriture (auteur, jeton), lu par le journal

  @@index([empreinte])
}

// Argent dépensé. Rattachée à un chantier, ou explicitement hors chantier (frais
// généraux) ; « à rattacher » tant que ni l'un ni l'autre. Une dépense saisie
// par erreur s'archive avec son motif.
model Depense {
  id                   String    @id @default(cuid())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  payeeLe              DateTime // date du ticket ou de la facture fournisseur
  montant              Float // euros payés (franchise de TVA : rien à récupérer)
  fournisseur          String
  categorie            String // CategorieDepense (src/lib/depenses/constantes.ts)
  libelle              String?
  moyen                String? // CARTE | VIREMENT | ESPECES | CHEQUE | PRELEVEMENT | AUTRE
  dossierId            String?
  dossier              Dossier?  @relation(fields: [dossierId], references: [id], onDelete: Restrict)
  horsChantier         Boolean   @default(false) // frais généraux, choisis explicitement
  justificatifId       String?
  justificatif         Fichier?  @relation(fields: [justificatifId], references: [id], onDelete: Restrict)
  identifiantHorsLigne String?   @unique // saisie sur téléphone : renvoyée sans doublon après une coupure réseau
  note                 String?
  archiveLe            DateTime?
  archiveMotif         String?
  ecriture             String? // contexte de la dernière écriture (auteur, jeton), lu par le journal

  @@index([payeeLe])
  @@index([dossierId])
}

// Synthèse d'un mois écoulé, figée une fois et jamais recalculée (la base refuse
// de la modifier). Sans nom de personne : clients et dossiers par identifiant.
model InstantaneMensuel {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  mois      String   @unique // AAAA-MM
  version   Int // VERSION_SYNTHESE au moment du gel
  contenu   String // JSON Synthese
  empreinte String // SHA-256 du contenu
  ecriture  String? // contexte de la dernière écriture (auteur, jeton), lu par le journal
}

// Connexion au compte Google (Drive, Gmail). Le jeton de renouvellement est
// chiffré (AES-256-GCM, clé GOOGLE_TOKEN_KEY hors base) ; une déconnexion garde
// la ligne (deconnecteLe), une reconnexion en crée une nouvelle.
model ConnexionGoogle {
  id             String    @id @default(cuid())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  compte         String // adresse du compte autorisé
  portees        String // portées accordées, séparées par des espaces
  jetonChiffre   String // jeton de renouvellement chiffré
  deconnecteLe   DateTime?
  derniereErreur String?
  ecriture       String? // contexte de la dernière écriture (auteur, jeton), lu par le journal
}

// État du miroir Google Drive : un élément du CRM (client, dossier, photo,
// document, justificatif…) et sa copie dans Drive. La base reste la source :
// Drive n'est jamais lu pour nourrir le CRM. Hors journal : état technique
// réécrit à chaque passage (voir docs, section 15).
model MiroirDrive {
  id             String    @id @default(cuid())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  cle            String    @unique // ce que l'élément représente : « client:<id> », « document:<id> »…
  driveId        String?
  nom            String
  parentCle      String?
  empreinte      String? // version du contenu envoyé (fichiers)
  etat           String    @default("A_CREER") // A_CREER | A_JOUR | ARCHIVE
  synchroniseLe  DateTime?
  derniereErreur String?
  ecriture       String? // contexte de la dernière écriture (auteur, jeton), lu par le journal

  @@index([etat])
}

// ─────────────────────────────────────────────
// Messages (src/lib/messages) : la boîte mail aujourd'hui, WhatsApp demain
// (même modèle, autre canal). L'agent trie : bruit archivé dans la boîte (jamais
// supprimé), mail rattaché au client et au dossier, le reste dans la file « À
// trier ». Ses analyses et ses appels au modèle sont gardés, jamais réécrits.
// ─────────────────────────────────────────────

model Message {
  id               String           @id @default(cuid())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  canal            String // EMAIL | WHATSAPP
  compte           String // boîte (ou numéro) qui a reçu ou envoyé
  identifiantCanal String // identifiant du message chez le fournisseur (Gmail…)
  filCanal         String? // fil de discussion chez le fournisseur
  sens             String // ENTRANT | SORTANT
  de               String // adresse e-mail (ou numéro) normalisée de l'expéditeur
  deNom            String?
  a                String           @default("[]") // JSON string[] : destinataires normalisés
  objet            String?
  extrait          String?
  recuLe           DateTime
  statut           String           @default("A_ANALYSER") // A_ANALYSER | A_TRIER | RATTACHE | BRUIT | IGNORE
  categorie        String? // décidée : CLIENT | NOUVELLE_DEMANDE | FOURNISSEUR | ADMINISTRATIF | PERSONNEL | BRUIT | AUTRE
  clientId         String?
  client           Client?          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  dossierId        String?
  dossier          Dossier?         @relation(fields: [dossierId], references: [id], onDelete: Restrict)
  trieLe           DateTime? // dernière décision de tri
  triePar          String? // acteur de cette décision (personne, ou agent pour une action autorisée)
  boiteArchiveLe   DateTime? // retiré de la boîte de réception chez le fournisseur (jamais supprimé)
  bruitAnnuleLe    DateTime? // « ce n'est pas du bruit » : tri corrigé, remis dans la boîte
  // Mission 7 (22/09/2026) : l'onglet Mail (src/lib/mail). Le tri classe, Gmail suit (libellés), rien ne s'efface.
  classe           String? // CLIENT | ADMINISTRATIF | HUMAIN | BRUIT (mail/tri.ts, ou Lucas)
  classeMotif      String? // pourquoi, en une phrase
  classePar        String? // TRI | LUCAS | REGLE
  leadId           String? // contact connu sans fiche client (lead)
  lead             Lead?            @relation(fields: [leadId], references: [id], onDelete: Restrict)
  lu               Boolean          @default(false) // miroir de Gmail (libellé UNREAD absent)
  dansBoite        Boolean          @default(true) // miroir de Gmail (libellé INBOX)
  rangeLe          DateTime? // rangé : libellé CoverSwap/Rangé, lu, hors de la boîte de réception ; réversible
  rangeMotif       String?
  rangePar         String? // TRI (d'office) | LUCAS (« ne plus me montrer », « tout nettoyer »)
  traiteLe         DateTime? // archivé par Lucas : sort d'« À traiter » (et de la boîte de réception Gmail)
  reponduLe        DateTime? // une réponse de la boîte est partie plus tard dans le même fil
  remonteLe        DateTime? // remonté à la main après un rangement : son expéditeur n'est plus jamais rangé
  automatique      Boolean          @default(false) // envoyé par le CRM sans clic (notification de l'espace)
  // Mission 9 (23/09/2026) : ce que Claude (par le MCP) écrit sur un mail, et que Lucas corrige. Le CRM ne lit rien seul.
  intention        String? // REPONSE | ACTION | INFORMATION ; null = non classé
  intentionAttendu String? // « ce qui est attendu » : « Il demande le délai de pose », « Facture à régler avant le 30 »
  intentionPar     String? // acteur qui a classé (ASSISTANT:claude, HUMAIN:…)
  intentionLe      DateTime?
  datesExtraites   String           @default("[]") // JSON [{ date, heure?, nature: DISPONIBILITE | ECHEANCE, passage }]
  snoozeJusqua     DateTime? // remis à plus tard : hors d'« À traiter » jusque-là, puis « Revenu » en tête
  snoozeLe         DateTime?
  snoozePar        String?
  contenu          ContenuMessage?
  pieces           PieceMessage[]
  analyses         AnalyseMessage[]
  archiveLe        DateTime?
  archiveMotif     String?
  ecriture         String? // contexte de la dernière écriture (auteur, jeton), lu par le journal

  @@unique([canal, identifiantCanal])
  @@index([statut, recuLe])
  @@index([classe, recuLe])
  @@index([leadId])
  @@index([clientId])
  @@index([dossierId])
  @@index([filCanal])
  @@index([de])
  @@index([snoozeJusqua])
}

// Mission 9 : le résumé d'un fil (3 lignes) et ses points en suspens, écrits par Claude, corrigés par Lucas.
model ResumeFil {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  canal           String
  filCanal        String
  resume          String
  pointsEnSuspens String   @default("[]") // JSON [{ texte, date? }] : question sans réponse, engagement pris
  messages        Int      @default(0) // nombre de messages du fil au moment du résumé
  par             String? // acteur
  ecriture        String?

  @@unique([canal, filCanal])
}

// Contenu reçu, écrit une fois (hors journal : le journal en dupliquerait chaque
// mail) ; la base refuse de le modifier, sauf son effacement RGPD, une fois.
model ContenuMessage {
  messageId   String    @id
  message     Message   @relation(fields: [messageId], references: [id], onDelete: Restrict)
  texte       String? // texte brut (HTML converti), tronqué
  entetes     String    @default("{}") // JSON : en-têtes utiles au tri et aux réponses
  anonymiseLe DateTime?
  ecriture    String? // contexte de la dernière écriture (auteur, jeton), lu par le journal
}

// Pièce jointe : décrite à la réception ; photo ou PDF conservé dans le CRM
// (Fichier) dès que le message n'est pas du bruit.
model PieceMessage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Restrict)
  rang      Int
  nom       String
  typeMime  String
  taille    Int
  partie    String // partie du message chez le fournisseur (partId Gmail)
  enLigne   Boolean  @default(false) // image intégrée au corps (logo, signature…)
  statut    String   @default("A_CONSERVER") // A_CONSERVER | CONSERVEE | NON_CONSERVEE
  raison    String? // pourquoi non conservée
  fichierId String?
  fichier   Fichier? @relation(fields: [fichierId], references: [id], onDelete: Restrict)
  ecriture  String? // contexte de la dernière écriture (auteur, jeton), lu par le journal

  @@unique([messageId, rang])
}

// Une analyse d'un message : par les règles (signaux relevés) ou par le modèle
// (son raisonnement, sa sortie structurée). Jamais réécrite.
model AnalyseMessage {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  messageId    String
  message      Message   @relation(fields: [messageId], references: [id], onDelete: Restrict)
  methode      String // REGLES | MODELE
  categorie    String?
  confiance    Float? // calculée par le code
  raisonnement String? // tel que formulé : signaux des règles, ou explication du modèle
  resultat     String    @default("{}") // JSON : décision, sortie du modèle, propositions faites
  erreur       String?
  appelIaId    String?
  appelIa      AppelIa?  @relation(fields: [appelIaId], references: [id], onDelete: Restrict)
  anonymiseLe  DateTime? // RGPD : raisonnement et résultat effacés, une fois
  ecriture     String? // contexte de la dernière écriture (auteur, jeton), lu par le journal

  @@index([messageId, createdAt])
}

// Registre des appels à un modèle d'IA : jetons et coût (prix datés en vigueur).
// Sert au plafond mensuel ; jamais réécrit.
model AppelIa {
  id           String           @id @default(cuid())
  createdAt    DateTime         @default(now())
  usage        String // ANALYSE_MESSAGE…
  modele       String
  jetonsEntree Int              @default(0)
  jetonsSortie Int              @default(0)
  coutEuros    Float? // null si les prix n'étaient pas connus
  dureeMs      Int
  statut       String // REUSSI | ECHEC
  erreur       String?
  analyses     AnalyseMessage[]
  ecriture     String? // contexte de la dernière écriture (auteur, jeton), lu par le journal

  @@index([createdAt])
}

// Registre des alertes envoyées au gérant (push, mail) : une ligne par envoi,
// avec le résultat de chaque canal. Sert à montrer un canal en panne ailleurs
// que dans les journaux du serveur, et à décider de l'auto-test au démarrage.
// Aucun nom ni numéro : seulement l'origine de l'alerte et l'état des canaux.
model AlerteEnvoi {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  origine   String // lead-meta | relance-lead | lead-illisible | essai | demarrage | sms-recu | espace-client | …
  abouti    Boolean // au moins un canal a abouti
  pousse    Boolean // au moins un canal POUSSÉ (Telegram, ntfy, push web) a abouti
  resultats String // JSON : [{canal, ok, configure, detail}]
  ecriture  String?

  @@index([createdAt])
}

// ─────────────────────────────────────────────
// Messagerie SMS (src/lib/sms) — mission du 20/09/2026
// Une conversation par numéro de téléphone. Un numéro inconnu crée une
// conversation orpheline (« à rattacher »), jamais perdue. Chaque SMS écrit
// aussi un événement sur le dossier quand il y en a un : la messagerie est une
// vue sur l'histoire du contact, pas un système à part.
// ─────────────────────────────────────────────

model ConversationSms {
  id               String    @id @default(cuid())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  numero           String    @unique // format international : +33612345678
  clientId         String?
  client           Client?   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  leadId           String?
  lead             Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  nomAffiche       String? // nom connu au moment du rattachement (la liste n'attend pas une jointure)
  dernierMessageLe DateTime?
  dernierExtrait   String? // aperçu du dernier message
  dernierSens      String? // ENTRANT | SORTANT
  nonLus           Int       @default(0) // SMS reçus pas encore ouverts
  premierEnvoiLe   DateTime? // premier SMS sortant : c'est lui qui porte la mention STOP
  stopLe           DateTime? // STOP reçu : plus aucun envoi vers ce numéro
  stopTexte        String? // le message qui a valu l'arrêt, tel que reçu
  brouillon        String? // texte en cours de saisie, gardé d'un écran et d'un appareil à l'autre
  messages         Sms[]
  archiveLe        DateTime? // archivage : rien ne se supprime
  archiveMotif     String?
  ecriture         String? // contexte de la dernière écriture (auteur, jeton), lu par le journal

  @@index([dernierMessageLe])
  @@index([clientId])
  @@index([leadId])
}

model Sms {
  id                     String          @id @default(cuid())
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  conversationId         String
  conversation           ConversationSms @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  sens                   String // ENTRANT | SORTANT
  texte                  String
  statut                 String // A_ENVOYER | ENVOYE | DELIVRE | ECHEC | RECU
  erreur                 String?
  fournisseur            String? // ovh | brevo | simulateur | webhook
  identifiantFournisseur String? // identifiant du message chez le fournisseur
  origine                String          @default("MANUEL") // MANUEL | MODELE | ACCUSE_AUTO | RELANCE | LIEN_ESPACE
  modele                 String? // code du message type proposé (ModeleSms.code)
  // Trace des corrections : ce que le CRM proposait, à côté de ce qui est parti
  // (`texte`). Dans un mois, on saura quelles formulations Lucas garde ou réécrit.
  textePropose           String?
  contexteEtape          String? // étape du dossier (ou statut du contact) au moment de l'envoi
  propositionId          String? // proposition validée dont ce SMS est l'exécution
  cleEnvoi               String?         @unique // idempotence : l'identifiant fabriqué par l'écran (envoi optimiste, file hors ligne)
  segments               Int? // nombre de SMS facturés
  envoyeLe               DateTime?
  delivreLe              DateTime?
  recuLe                 DateTime? // entrant : horodatage du fournisseur
  luLe                   DateTime? // entrant : ouvert dans la messagerie
  tentatives             Int             @default(0)
  // Rattachements au moment du message (l'histoire ne bouge pas si la conversation est rattachée ailleurs ensuite)
  clientId               String?
  leadId                 String?
  dossierId              String?
  archiveLe              DateTime?
  archiveMotif           String?
  ecriture               String? // contexte de la dernière écriture (auteur, jeton), lu par le journal

  @@unique([fournisseur, identifiantFournisseur])
  @@index([conversationId, createdAt])
  @@index([statut])
  @@index([dossierId])
}

// Messages types : le CRM pré-remplit, Lucas corrige et envoie. Seul l'accusé de
// réception part sans validation (`automatique`).
model ModeleSms {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  code         String    @unique // ACCUSE_RECEPTION, LIEN_ESPACE, RELANCE_PHOTOS…
  libelle      String
  texte        String // variables : {prenom}, {lien}, {montant}…
  actif        Boolean   @default(true)
  automatique  Boolean   @default(false) // part seul (accusé de réception uniquement)
  ordre        Int       @default(0)
  archiveLe    DateTime?
  archiveMotif String?
  ecriture     String?
}

// ─────────────────────────────────────────────
// Espace client (src/lib/espace) : la page personnelle du client sur
// coverswap.fr, ouverte par un lien signé, sans compte ni mot de passe.
// Le lien = code court + signature HMAC(secret, code + version). Révoquer =
// incrémenter `version` : tous les anciens liens meurent d'un coup.
// ─────────────────────────────────────────────

// L'espace PERMANENT d'un client (mission 5, 22/09/2026) : un client = un espace, pour toujours. Son lien
// (code + version signés, src/lib/espace/liens.ts) ne meurt pas ; il se révoque ou se régénère. Il contient
// ses projets (EspaceClient, un par dossier), ses favoris, et la confirmation du téléphone demandée après
// 90 jours sans visite.
model EspacePermanent {
  id                  String         @id @default(cuid())
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  code                String         @unique
  version             Int            @default(1)
  clientId            String         @unique
  client              Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  lienEmisLe          DateTime       @default(now()) // dernière émission du lien (création, régénération)
  revoqueLe           DateTime?
  premierAccesLe      DateTime?
  dernierAccesLe      DateTime?
  nbAcces             Int            @default(0)
  confirmeLe          DateTime? // dernière confirmation du téléphone (4 derniers chiffres)
  confirmationEchecs  Int            @default(0) // essais manqués depuis la dernière réussite
  confirmationEchecLe DateTime?
  favoris             String? // JSON : références Cover Styl' mises en favori (catalogue de l'espace)
  projetsAccordes     Int            @default(0) // projets en cours accordés par Lucas au-delà de deux
  projetDemandeLe     DateTime? // le client a demandé à ouvrir un projet de plus
  fusionneDansId      String? // clients fusionnés : l'espace conservé, vers lequel ce lien mène
  projets             EspaceClient[]
  archiveLe           DateTime?
  archiveMotif        String?
  ecriture            String?
}

model EspaceClient {
  id                      String             @id @default(cuid())
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  code                    String             @unique // court, lisible dans l'adresse
  version                 Int                @default(1)
  dossierId               String             @unique // un espace par dossier
  dossier                 Dossier            @relation(fields: [dossierId], references: [id], onDelete: Restrict)
  expireLe                DateTime
  revoqueLe               DateTime?
  premierAccesLe          DateTime?
  dernierAccesLe          DateTime?
  nbAcces                 Int                @default(0)
  souhaits                String? // JSON : le projet du client (zones, styles, mètres, délai, précisions) — ancien format : teintes, style
  souhaitsLe              DateTime?
  choix                   String? // JSON : une simulation, ou une teinte par zone piochée dans plusieurs (choix composite)
  choixLe                 DateTime?
  propositionDemandeeLe   DateTime? // dernière demande d'une autre proposition
  devisConsultations      Int                @default(0) // visites où le client a ouvert son devis en vigueur
  devisConsulteId         String? // devis auquel se rapporte le compteur
  devisConsulteLe         DateTime?
  simulationsVuesLe       DateTime? // dernière ouverture de ses simulations : au-delà, elles sont « nouvelles »
  avis                    String? // JSON : note, texte, accord de publication (après le chantier)
  avisLe                  DateTime?
  // Espace v3 (21/09/2026) : le client crée ses simulations lui-même, dans une limite.
  simulationsAccordees    Int                @default(0) // simulations offertes en plus du nombre gratuit (paramètre)
  simulationsDemandeesLe  DateTime? // dernière demande de simulations supplémentaires
  favoris                 String? // JSON : références Cover Styl' mises en favori par le client
  // Mission 4 (22/09/2026) : tout ce que le client valide se dévalide ; ce qu'il écrit reste lisible ici.
  projetValideLe          DateTime? // le client a validé son projet (pastille verte) ; remis à null s'il le modifie ou le dévalide
  projetValidePar         String? // CLIENT | LUCAS : qui a validé
  propositionMessage      String? // le mot du client avec sa demande d'autre proposition (entier)
  propositionSimulationId String? // la simulation depuis laquelle il a demandé autre chose
  photosRetirees          String? // JSON [{ id, chemin, archive, le }] : photos retirées par le client (archivées, retrouvables)
  // Mission 5 (22/09/2026) : cet espace est un PROJET de l'espace permanent de son client. Son code reste
  // un lien valide (alias) : il ouvre l'espace du client sur ce projet.
  permanentId             String?
  permanent               EspacePermanent?   @relation(fields: [permanentId], references: [id], onDelete: Restrict)
  nomProjet               String? // le nom que le client lui a donné (« La salle de bain du haut »)
  simulations             SimulationEspace[]
  archiveLe               DateTime?
  archiveMotif            String?
  ecriture                String?

  @@index([permanentId])
}

// Simulation déposée par Lucas dans l'espace d'un client : le client les compare,
// en choisit une, commente.
model SimulationEspace {
  id                String       @id @default(cuid())
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  espaceId          String
  espace            EspaceClient @relation(fields: [espaceId], references: [id], onDelete: Restrict)
  dossierId         String
  chemin            String // image, relative au répertoire d'upload
  titre             String?
  description       String?
  ordre             Int          @default(0)
  choisieLe         DateTime?
  commentaireClient String?
  commenteeLe       DateTime?
  // Simulateur (21/09/2026) : toute simulation d'un dossier, d'où qu'elle vienne. Le client ne voit
  // que les PUBLIEE ; celles du CRM arrivent en BROUILLON, celles qu'il a faites sur le site sont publiées.
  source            String       @default("MANUEL") // SITE | API | CHATGPT | MANUEL
  statut            String       @default("PUBLIEE") // BROUILLON | PUBLIEE | MASQUEE
  photoAvant        String? // photo « avant » utilisée, relative au répertoire d'upload (curseur avant / après)
  typeSurface       String? // type de surface du simulateur (cuisine, meubles-hauts…) ; pour le site : le projet
  zones             String? // JSON [{ zone, libelle, ref, nom }] : la teinte posée sur chaque zone
  promptId          String? // prompt de la bibliothèque (ChatGPT)
  promptVersion     Int?
  promptTexte       String? // consigne réellement donnée au modèle
  preparationId     String?
  simulationId      String? // Simulation du contact, quand elle a été faite sur le site
  coutDollars       Float? // génération par l'API
  publieeLe         DateTime?
  masqueeLe         DateTime?
  vueLe             DateTime? // première fois que le client l'a vue
  archiveLe         DateTime?
  archiveMotif      String?
  ecriture          String?

  @@index([espaceId])
  @@index([dossierId])
  @@index([simulationId])
}

// Bon pour accord donné par le client dans son espace : une ligne, jamais
// modifiée. Vaut signature même sans paiement immédiat.
model AccordDevis {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  dossierId     String
  dossier       Dossier   @relation(fields: [dossierId], references: [id], onDelete: Restrict)
  documentId    String // le devis accepté
  numeroDevis   String?
  totalHt       Float // montant figé au moment de l'accord
  acomptePct    Int?
  nomSignataire String
  mention       String // « Bon pour accord »
  signature     String? // signature tracée au doigt (image, relative au répertoire d'upload), si le client a signé
  ip            String?
  navigateur    String?
  // Un accord se retire (par le client tant que rien n'est encaissé, ou par Lucas) : la preuve reste, annotée.
  retireLe      DateTime?
  retirePar     String? // CLIENT | LUCAS | SYSTEME
  retireMotif   String?
  ecriture      String?

  @@index([dossierId])
  @@index([documentId])
}

// ─────────────────────────────────────────────
// Application installée (PWA) : abonnements aux notifications poussées du
// navigateur, et clés internes générées par le serveur (paire VAPID).
// ─────────────────────────────────────────────

model AbonnementPush {
  id             String    @id @default(cuid())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  endpoint       String    @unique
  p256dh         String
  auth           String
  application    String    @default("crm") // crm | messages : l'icône depuis laquelle l'abonnement a été pris
  utilisateur    String? // adresse de la personne connectée
  appareil       String? // navigateur, tel qu'annoncé
  dernierEnvoiLe DateTime?
  echecs         Int       @default(0)
  archiveLe      DateTime? // abonnement expiré ou révoqué par le navigateur
  archiveMotif   String?
  ecriture       String?
}

// Clés générées par le serveur quand aucune variable d'environnement ne les
// fournit (paire VAPID du push web). Hors journal : le journal copierait la clé.
model CleInterne {
  nom       String   @id
  valeur    String
  createdAt DateTime @default(now())
  ecriture  String?
}

// ─────────────────────────────────────────────
// Simulateur du CRM (src/lib/simulateur) — mission du 21/09/2026
// Un moteur, trois portes : le client sur le site, Lucas par l'API, Lucas
// par ChatGPT. Toutes les simulations atterrissent dans le dossier
// (SimulationEspace), en brouillon tant que Lucas ne les publie pas.
// ─────────────────────────────────────────────

/// Une simulation préparée depuis le CRM : pour ChatGPT (consigne, planche des
/// teintes, photo cadrée) ou pour l'API (génération en tâche de fond). L'image
/// rendue par ChatGPT, déposée ensuite, reprend tout ce qui est noté ici.
model PreparationSimulation {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  dossierId     String
  mode          String // CHATGPT | API
  origine       String    @default("CRM") // CRM (Lucas) | CLIENT (le client, depuis son espace)
  statut        String    @default("PREPAREE") // PREPAREE | EN_COURS | TERMINEE | ECHEC
  photoSource   String // photo du dossier choisie (chemin relatif)
  photoAvant    String? // la même, cadrée au format du modèle (chemin relatif)
  typeSurface   String
  zones         String // JSON [{ zone, libelle, ref, nom, description }]
  promptId      String?
  promptVersion Int?
  promptTexte   String?
  coutEstime    Float? // en dollars
  erreur        String?
  resultatId    String? // SimulationEspace produite
  archiveLe     DateTime?
  archiveMotif  String?
  ecriture      String?

  @@index([dossierId, createdAt])
}

/// Bibliothèque de prompts ChatGPT : un prompt par type de surface. Le texte vit
/// dans ses versions ; `versionCourante` désigne celle qui sert.
model PromptSimulation {
  id              String                    @id @default(cuid())
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  typeSurface     String                    @unique
  versionCourante Int                       @default(1)
  versions        PromptSimulationVersion[]
  archiveLe       DateTime?
  archiveMotif    String?
  ecriture        String?
}

/// Une version de prompt, jamais modifiée : revenir en arrière crée une nouvelle version.
model PromptSimulationVersion {
  id        String           @id @default(cuid())
  createdAt DateTime         @default(now())
  promptId  String
  prompt    PromptSimulation @relation(fields: [promptId], references: [id], onDelete: Restrict)
  numero    Int
  texte     String
  note      String? // ce qui a changé, en une phrase
  auteur    String?
  ecriture  String?

  @@unique([promptId, numero])
}

/// Une génération d'image payée à OpenAI (simulateur du site ou du CRM), écrite
/// une fois : c'est le compteur de consommation.
model GenerationImage {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  origine       String // SITE | CRM | ESPACE
  modele        String
  statut        String // REUSSI | ECHEC
  erreur        String?
  dureeMs       Int
  taille        String?
  echantillons  Int      @default(0)
  jetonsTexte   Int      @default(0)
  jetonsImage   Int      @default(0)
  jetonsSortie  Int      @default(0)
  coutDollars   Float?
  dossierId     String?
  preparationId String?
  ecriture      String?

  @@index([createdAt])
}

// Notes prises pendant un appel à un contact : une par appel, datée, avec ses étiquettes
// (trop cher, veut réfléchir…). Enregistrées au fil de la frappe. Elles restent sur la fiche
// du contact même s'il n'aboutit jamais ; à l'ouverture de son dossier, elles sont reprises
// dans l'historique, à leur date (dossierEvenementId).
model NoteAppel {
  id                 String    @id @default(cuid())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  leadId             String
  lead               Lead      @relation(fields: [leadId], references: [id], onDelete: Restrict)
  appelLe            DateTime  @default(now()) // début de l'appel (ou de la note)
  texte              String    @default("")
  etiquettes         String    @default("[]") // JSON : codes (TROP_CHER, VEUT_REFLECHIR…)
  issue              String? // issue notée en fin d'appel (INTERESSE, A_RAPPELER…)
  dossierEvenementId String? // reprise dans l'historique du dossier
  archiveLe          DateTime?
  archiveMotif       String?
  ecriture           String?

  @@index([leadId, appelLe])
}

// ─────────────────────────────────────────────
// Onglet Mail (mission 7, 22/09/2026) : src/lib/mail
// ─────────────────────────────────────────────

// Ce que Lucas a décidé pour un expéditeur (adresse exacte, ou domaine « @exemple.fr ») : « ne plus me montrer »
// (RANGER, pour toujours), « remonté à tort » (NE_JAMAIS_RANGER), ou « administratif ». Les règles passent avant le tri.
model RegleExpediteur {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  cible        String // adresse exacte en minuscules, ou domaine « @exemple.fr »
  action       String // RANGER | NE_JAMAIS_RANGER | ADMINISTRATIF
  motif        String?
  par          String?
  archiveLe    DateTime?
  archiveMotif String?
  ecriture     String?

  @@index([cible])
}

// Où en est la synchronisation d'une boîte Gmail (historique incrémental).
model EtatBoiteMail {
  compte          String    @id
  updatedAt       DateTime  @updatedAt
  historyId       String? // dernier point de l'historique Gmail lu
  derniereSynchro DateTime?
  derniereErreur  String?
  ecriture        String?
}

// Tout mail qui part du CRM : notification automatique, réponse ou nouveau mail validé par Lucas, étape de
// séquence, essai. La clé est unique : un même envoi ne part jamais deux fois.
model EnvoiMail {
  id               String    @id @default(cuid())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  cle              String    @unique // notif:SIMULATION_PUBLIEE:<id>, reponse:<brouillon>, sequence:<inscription>:<étape>…
  nature           String // NOTIFICATION | REPONSE | NOUVEAU | SEQUENCE | ESSAI
  modele           String? // code du modèle (notifications, séquences)
  statut           String    @default("A_ENVOYER") // A_ENVOYER | ENVOYE | ECHEC | ANNULE
  a                String
  objet            String
  texte            String
  html             String?
  entetes          String? // JSON : en-têtes ajoutés (List-Unsubscribe des séquences)
  enReponseA       String? // Message (reçu) auquel on répond : même fil
  dossierId        String?
  clientId         String?
  leadId           String?
  brouillonId      String?
  messageId        String? // le Message enregistré à l'envoi
  identifiantCanal String?
  envoyeLe         DateTime?
  erreur           String?
  ecriture         String?

  @@index([dossierId])
  @@index([statut, createdAt])
}

// Brouillon rédigé par l'IA, à la demande de Lucas : ce qu'elle savait (contexte), ce qu'elle a écrit, ce que
// Lucas a envoyé. La matière pour améliorer l'IA plus tard ; rien ne part sans son clic.
model BrouillonMail {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  messageId   String? // mail auquel il répond
  clientId    String?
  dossierId   String?
  leadId      String?
  a           String?
  consigne    String?
  source      String    @default("IA_CRM") // IA_CRM (modèle appelé par le CRM) | ASSISTANT (déposé par Claude via le MCP, mission 9)
  objetIa     String?
  texteIa     String?
  manques     String    @default("[]") // JSON : ce que l'IA n'a pas trouvé dans le CRM ([à compléter])
  corrections String    @default("[]") // JSON : montants, dates ou délais retirés par la garde (absents du CRM)
  contexte    String // JSON : les faits envoyés au modèle
  appelIaId   String?
  coutEuros   Float?
  objetEnvoye String?
  texteEnvoye String?
  modifie     Boolean? // la version envoyée diffère de celle de l'IA
  statut      String    @default("BROUILLON") // BROUILLON | ENVOYE | ABANDONNE
  envoiId     String?
  envoyeLe    DateTime?
  ecriture    String?

  @@index([messageId])
  @@index([clientId])
}

// Textes réglables sans déploiement : guide de style des mails, modèles des notifications (Paramètres).
model ReglageTexte {
  cle       String   @id // GUIDE_STYLE | NOTIF_SIMULATION_PUBLIEE | NOTIF_DEVIS_DISPONIBLE | …
  updatedAt DateTime @updatedAt
  valeur    String // JSON ou texte selon la clé
  par       String?
  ecriture  String?
}

// Séquences de mails (déclencheur, étapes espacées, arrêt) : construites, JAMAIS activées sans Lucas.
model SequenceMail {
  id           String                @id @default(cuid())
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  code         String                @unique // INJOIGNABLE | DEVIS_NON_SIGNE | AVIS | REACTIVATION
  nom          String
  declencheur  String
  description  String?
  mode         String                @default("VALIDATION") // VALIDATION | AUTOMATIQUE
  active       Boolean               @default(false)
  plafondJour  Int                   @default(10)
  etapes       EtapeSequence[]
  inscriptions InscriptionSequence[]
  ecriture     String?
}

model EtapeSequence {
  id         String       @id @default(cuid())
  updatedAt  DateTime     @updatedAt
  sequenceId String
  sequence   SequenceMail @relation(fields: [sequenceId], references: [id], onDelete: Restrict)
  rang       Int
  delaiJours Int // après l'entrée (étape 1) ou après l'étape précédente
  objet      String
  texte      String // variables : {prenom}, {lien}, {devis}, {montant}…
  ecriture   String?

  @@unique([sequenceId, rang])
}

model InscriptionSequence {
  id              String       @id @default(cuid())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  sequenceId      String
  sequence        SequenceMail @relation(fields: [sequenceId], references: [id], onDelete: Restrict)
  cle             String       @unique // séquence + dossier ou lead : une seule inscription
  adresse         String
  dossierId       String?
  leadId          String?
  clientId        String?
  etapeFaite      Int          @default(0)
  statut          String       @default("EN_COURS") // EN_COURS | EN_VALIDATION | ARRETEE | TERMINEE
  arretMotif      String?
  prochainEnvoiLe DateTime?
  ecriture        String?

  @@index([statut, prochainEnvoiLe])
}

// Désinscription des séquences : définitive, jamais retirée.
model Desinscription {
  adresse   String   @id
  createdAt DateTime @default(now())
  source    String // LIEN | LUCAS | REPONSE
  ecriture  String?
}

// ─────────────────────────────────────────────
// Mission 8 : l'assistant Claude (serveur MCP). Le CRM est son propre serveur
// d'autorisation OAuth 2.1 : Claude s'y connecte par le consentement de Lucas
// (session du CRM), reçoit des jetons opaques (hachés ici), révocables depuis
// Paramètres. Chaque appel d'outil est journalisé, avec la commande d'origine.
// ─────────────────────────────────────────────

model ClientOAuth {
  id           String    @id // client_id : identifiant aléatoire (enregistrement dynamique) ou adresse https du document d'identité (CIMD)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  nom          String // nom affiché au consentement (« Claude »)
  redirectUris String    @default("[]") // JSON string[] : adresses de retour permises, vérifiées à l'identique
  secretHash   String? // client confidentiel : empreinte SHA-256 du secret ; null = client public (PKCE)
  origine      String    @default("DCR") // DCR (enregistrement dynamique) | CIMD (document d'identité) | MANUEL
  revoqueLe    DateTime?
  revoqueMotif String?
  ecriture     String?
}

model CodeOAuth {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  codeHash      String    @unique // empreinte SHA-256 du code d'autorisation (jamais le code en clair)
  clientId      String
  redirectUri   String
  codeChallenge String // PKCE S256
  scope         String
  resource      String? // RFC 8707 : l'adresse du serveur MCP visé
  utilisateur   String // e-mail de la personne qui a consenti
  expireLe      DateTime
  utiliseLe     DateTime? // un code ne s'échange qu'une fois
  ecriture      String?

  @@index([clientId])
}

model JetonOAuth {
  id              String    @id @default(cuid())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  jetonHash       String    @unique // empreinte SHA-256 du jeton (jamais le jeton en clair)
  type            String // ACCES | RENOUVELLEMENT
  clientId        String
  utilisateur     String
  scope           String
  resource        String?
  familleId       String // même famille pour un jeton d'accès et son jeton de renouvellement (rotation)
  expireLe        DateTime
  revoqueLe       DateTime?
  revoqueMotif    String?
  dernierUsageLe  DateTime?
  clientNom       String? // nom du client MCP tel qu'il s'est présenté (initialize)
  ecriture        String?

  @@index([clientId, type])
  @@index([familleId])
}

model SessionAssistant {
  id             String    @id @default(cuid())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  jour           String // AAAA-MM-JJ (Paris) : une session par jeton et par jour
  jetonId        String?
  clientNom      String?
  dernierAppelLe DateTime?
  appels         Int       @default(0)
  ecritures      Int       @default(0)
  ecriture       String?

  @@unique([jour, jetonId])
}

model AppelOutil {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  sessionId  String
  outil      String
  niveau     String // LECTURE | REVERSIBLE | SENSIBLE
  parametres String   @default("{}") // JSON, tronqué ; jamais de secret
  commande   String? // la phrase de Lucas, telle que transmise par Claude
  statut     String   @default("FAIT") // FAIT | APERCU | REFUSE | ERREUR
  resume     String? // le résultat, en une ligne
  erreur     String?
  dureeMs    Int      @default(0)
  ecriture   String?

  @@index([sessionId, createdAt])
  @@index([createdAt])
}

model ConfirmationAssistant {
  id        String    @id // le jeton de confirmation remis à Claude
  createdAt DateTime  @default(now())
  outil     String
  empreinte String // SHA-256 de l'outil + des paramètres : le second appel doit être identique
  apercu    String // ce qui a été annoncé (« je vais archiver 12 leads… »)
  expireLe  DateTime
  utiliseLe DateTime?
  sessionId String?
  ecriture  String?
}

// ─────────────────────────────────────────────
// Mission 10 (23/09/2026) : les actions de l'assistant qui manquaient.
// ─────────────────────────────────────────────

// Une modification de dossier faite par l'assistant (ou par un écran demain) : chaque champ avec sa valeur
// d'avant et d'après, la phrase de Lucas, et l'annulation si elle a eu lieu. « annuler_modification » relit
// `champs` et remet chaque valeur d'avant par le même chemin.
model ModificationDossier {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  dossierId  String
  dossier    Dossier   @relation(fields: [dossierId], references: [id], onDelete: Restrict)
  champs     String // JSON [{ champ, libelle, avant, apres }]
  par        String // acteur (ASSISTANT:claude, HUMAIN:…)
  commande   String? // la phrase de Lucas, telle que transmise
  annuleeLe  DateTime?
  annuleePar String?
  ecriture   String?

  @@index([dossierId, createdAt])
}

// Les messages échangés dans l'espace client : ce que le client écrit (« Écrire à CoverSwap », commentaire
// d'une simulation, demande d'autre proposition) et ce que Lucas lui répond depuis l'assistant ou le CRM.
// Le client lit les réponses dans l'onglet Contact de son espace ; Lucas lit les messages non lus par
// « messages_espace ». Rien ne se supprime.
model MessageEspace {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  dossierId    String
  dossier      Dossier   @relation(fields: [dossierId], references: [id], onDelete: Restrict)
  espaceId     String? // le projet (EspaceClient) concerné, s'il est connu
  auteur       String // CLIENT | LUCAS
  source       String // MESSAGE | COMMENTAIRE | PROPOSITION | REPONSE
  texte        String
  simulationId String? // commentaire ou demande faits depuis une simulation
  luLe         DateTime? // message du client lu par Lucas ; réponse de Lucas vue par le client
  notifieLe    DateTime? // réponse : notification programmée au client
  par          String? // acteur qui a écrit la réponse (ASSISTANT:claude, HUMAIN:…)
  evenementId  String? // l'événement du dossier d'origine (reprise des messages d'avant la mission 10)
  archiveLe    DateTime?
  archiveMotif String?
  ecriture     String?

  @@index([dossierId, createdAt])
  @@index([auteur, luLe])
}

// Les versions d'un texte réglable (consignes, positionnement) : chaque enregistrement en crée une ; on
// restaure en écrivant une nouvelle version égale à l'ancienne. Rien ne s'écrase.
model VersionTexte {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  cle       String // CONSIGNES_ASSISTANT | POSITIONNEMENT_ASSISTANT
  numero    Int
  texte     String
  par       String? // qui a écrit (LUCAS, ASSISTANT:claude)
  commande  String? // la phrase de Lucas, quand la version vient de l'assistant
  ecriture  String?

  @@unique([cle, numero])
}
