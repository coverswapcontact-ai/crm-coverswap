generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Lead {
  id               String        @id @default(cuid())
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  nom              String
  prenom           String
  email            String?
  telephone        String
  ville            String
  codePostal       String?
  source           String        @default("AUTRE")
  statut           String        @default("NOUVEAU")
  typeProjet       String        @default("CUISINE")
  referenceChoisie String?
  mlEstimes        Float?
  prixDevis        Float?
  lienSimulation   String?
  scoreSignature   Int           @default(0)
  notes            String?
  // Client pérenne auquel ce contact est rattaché (src/lib/clients)
  clientId         String?
  client           Client?       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  // Acquisition, en champs (avant : noyée dans `notes`)
  campagne         String?
  publicite        String?
  formulaire       String?
  metaLeadgenId    String?
  interactions     Interaction[]
  devis            Devis[]
  chantier         Chantier?
  simulations      Simulation[]
  dossiers         Dossier[]
  archiveLe        DateTime? // archivage : rien ne se supprime
  archiveMotif     String?
  ecriture         String? // contexte de la dernière écriture (auteur, jeton), lu par le journal

  @@index([clientId])
}

model Simulation {
  id                String    @id @default(cuid())
  createdAt         DateTime  @default(now())
  leadId            String
  lead              Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  source            String    @default("SITE_SIMULATEUR")
  referenceChoisie  String?
  mlEstimes         Float?
  prixDevis         Float?
  lienSimulation    String?
  imageBeforePath   String?
  imageAfterPath    String?
  imageOriginalPath String?
  notes             String?
  archiveLe         DateTime? // archivage : rien ne se supprime
  archiveMotif      String?
  ecriture          String? // contexte de la dernière écriture (auteur, jeton), lu par le journal
}

model Interaction {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  type         String
  contenu      String
  leadId       String
  lead         Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  archiveLe    DateTime? // archivage : rien ne se supprime
  archiveMotif String?
  ecriture     String? // contexte de la dernière écriture (auteur, jeton), lu par le journal
}

model Devis {
  id                   String   @id @default(cuid())
  numero               String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  expiresAt            DateTime
  statut               String   @default("BROUILLON")
  reference            String // code libre ex "K1"
  nomReference         String? // nom commercial ex "Black mat"
  gamme                String   @default("ESSENTIAL") // GammeCode
  complexite           Int      @default(1) // 1=standard, 2=+10%, 3=+20%
  mlTotal              Float
  prixVenteHTml        Float    @default(0) // prix vente unitaire HT/ml
  prixMatiere          Float // coût matière TTC réel (pour marge interne)
  prixVente            Float // total vente client (= TTC pour CoverSwap 293B)
  margeNette           Float
  fraisDeplacement     Float    @default(0)
  acompte30            Float
  solde70              Float
  objet                String? // "Rénovation par covering meuble coiffeur"
  lignesAdditionnelles String   @default("[]") // JSON LigneAdditionnelle[]
  notesInternes        String?
  leadId               String
  lead                 Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  facture              Facture?
  ecriture             String? // contexte de la dernière écriture (auteur, jeton), lu par le journal
}

model Facture {
  id           String    @id @default(cuid())
  numero       String    @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  statut       String    @default("ACOMPTE_EN_ATTENTE")
  montantTotal Float
  acompteRecu  Boolean   @default(false)
  acompteDate  DateTime?
  soldeRecu    Boolean   @default(false)
  soldeDate    DateTime?
  devisId      String    @unique
  devis        Devis     @relation(fields: [devisId], references: [id], onDelete: Cascade)
  ecriture     String? // contexte de la dernière écriture (auteur, jeton), lu par le journal
}

model Chantier {
  id               String     @id @default(cuid())
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  dateIntervention DateTime
  adresse          String
  reference        String
  mlCommandes      Float
  prixMatiere      Float
  margeNette       Float
  statut           String     @default("COMMANDE_PASSEE")
  acompteRecu      Boolean    @default(false)
  soldeRecu        Boolean    @default(false)
  photosAvant      String     @default("[]")
  photosApres      String     @default("[]")
  leadId           String     @unique
  lead             Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  commandes        Commande[]
  archiveLe        DateTime? // archivage : rien ne se supprime
  archiveMotif     String?
  ecriture         String? // contexte de la dernière écriture (auteur, jeton), lu par le journal
}

model Commande {
  id                   String    @id @default(cuid())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  reference            String
  quantiteML           Float
  prixMatiere          Float
  fournisseur          String    @default("Tego France")
  emailFournisseur     String    @default("France@tego.eu")
  statut               String    @default("A_COMMANDER")
  dateCommande         DateTime?
  dateReceptionEstimee DateTime?
  dateReceptionReelle  DateTime?
  chantierId           String
  chantier             Chantier  @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  archiveLe            DateTime? // archivage : rien ne se supprime
  archiveMotif         String?
  ecriture             String? // contexte de la dernière écriture (auteur, jeton), lu par le journal
}

model Objectif {
  id              String    @id @default(cuid())
  periode         String    @unique
  caMensuel       Float
  nombreChantiers Int
  tauxConversion  Float
  createdAt       DateTime  @default(now())
  archiveLe       DateTime? // archivage : rien ne se supprime
  archiveMotif    String?
  ecriture        String? // contexte de la dernière écriture (auteur, jeton), lu par le journal
}

// ─────────────────────────────────────────────
// Module Prospection (agent IA B2B hôtels/restaurants)
// SQLite : pas d'enum ni de Json natifs — valeurs et structures
// documentées en commentaire, types TS dans src/lib/prospection/constants.ts
// ─────────────────────────────────────────────

model AgentProfile {
  id           String     @id @default(cuid())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  slug         String     @unique // "hotels" | "restaurants"
  nom          String
  actif        Boolean    @default(true)
  config       String     @default("{}") // JSON AgentProfileConfig : typesGooglePlaces, motsClesSignaux, blacklistMarques, angleVente, quotaJournalier
  prospects    Prospect[]
  archiveLe    DateTime? // archivage : rien ne se supprime
  archiveMotif String?
  ecriture     String? // contexte de la dernière écriture (auteur, jeton), lu par le journal
}

model Prospect {
  id              String             @id @default(cuid())
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  agentProfileId  String
  agentProfile    AgentProfile       @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  googlePlaceId   String             @unique
  nom             String
  adresse         String?
  ville           String?
  codePostal      String?
  telephone       String?
  siteWeb         String?
  email           String?
  emailType       String             @default("INCONNU") // EmailType : GENERIQUE | NOMINATIF | INCONNU
  noteGoogle      Float?
  nbAvis          Int?
  siret           String?
  anneeCreation   Int?
  statut          String             @default("SOURCE") // StatutProspect : SOURCE | QUALIFIE | ECARTE | CONTACTE | RELANCE | REPONDU | RDV | CLIENT | OPT_OUT
  score           Int                @default(0)
  scoreDetails    String? // JSON : décomposition du score par signal
  signalPrincipal String? // citation d'avis ou fait saillant détecté
  angleSuggere    String? // angle d'approche proposé pour l'email
  avisBruts       String? // JSON AvisBrut[] : avis Google bruts (servira au scoring étape 3)
  fermetureHebdo  String? // jour(s) de fermeture hebdo ex. "lundi" ou "dimanche, lundi" — null si 7j/7 ou inconnu
  optOut          Boolean            @default(false)
  optOutAt        DateTime?
  clientId        String? // client pérenne, à la conversion seulement
  client          Client?            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  emailDrafts     EmailDraft[]
  activites       ProspectActivity[]
  dossiers        Dossier[]
  archiveLe       DateTime? // archivage : rien ne se supprime
  archiveMotif    String?
  ecriture        String? // contexte de la dernière écriture (auteur, jeton), lu par le journal

  @@index([agentProfileId, statut])
  @@index([score])
}

model EmailDraft {
  id               String    @id @default(cuid())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  prospectId       String
  prospect         Prospect  @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  sequencePosition Int       @default(1) // 1=initial, 2=relance1, 3=relance2
  sujet            String
  corps            String
  statut           String    @default("BROUILLON") // StatutEmailDraft : BROUILLON | VALIDE | EDITE | REJETE | ENVOYE
  corpsOriginal    String? // version IA avant édition humaine (boucle de feedback)
  envoyeAt         DateTime?
  ouvertAt         DateTime?
  reponduAt        DateTime?
  archiveLe        DateTime? // archivage : rien ne se supprime
  archiveMotif     String?
  ecriture         String? // contexte de la dernière écriture (auteur, jeton), lu par le journal

  @@index([statut])
}

model ProspectActivity {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  type       String // TypeActivite : SOURCING | SCORING | DRAFT_CREE | VALIDATION | EDITION | ENVOI | OUVERTURE | REPONSE | OPT_OUT | NOTE
  details    String? // JSON : payload libre selon le type d'activité
  ecriture   String? // contexte de la dernière écriture (auteur, jeton), lu par le journal

  @@index([prospectId, createdAt])
}

// ─────────────────────────────────────────────
// Module Dossiers en cours (/dossiers)
// Un dossier = une affaire réelle, créée à la conversion (photos + coordonnées
// complètes + objet). Valeurs des champs String et structures JSON documentées
// dans src/lib/dossiers/constants.ts (SQLite : pas d'enum ni de Json natifs).
// ─────────────────────────────────────────────

model Dossier {
  id                     String             @id @default(cuid())
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  leadId                 String? // Lead B2C d'origine (Meta Ads, site, simulateur)
  lead                   Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)
  prospectId             String? // Prospect B2B d'origine (/prospection)
  prospect               Prospect?          @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  clientId               String? // client pérenne ; les champs client* restent les coordonnées de ce chantier
  client                 Client?            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  clientNom              String
  clientAdresse          String
  clientCp               String
  clientVille            String
  clientEmail            String?
  clientTelephone        String
  objet                  String // ex. "Recouvrement façades de cuisine"
  etape                  String             @default("QUALIFICATION") // EtapeDossier
  montantEstime          Float?
  source                 String // SourceDossier : PROSPECTION | RECOMMANDATION | SOUS_TRAITANCE | ENTRANT | AUTRE
  motifPerte             String? // MotifPerte, obligatoire à l'entrée en PERDU
  // Perte : figée au moment où le dossier passe en PERDU (retirée à la reprise ;
  // l'événement de changement d'étape la garde pour toujours).
  perteLe                DateTime?
  perteEtape             String? // étape active quittée
  perteConcurrent        String? // qui a remporté le marché, si on le sait
  perteMontantConcurrent Float? // son prix, si on le sait
  perteMontantPropose    Float? // notre dernier prix (dernier devis émis, sinon estimation)
  perteCommentaire       String?
  prochaineAction        String?
  prochaineActionDate    DateTime?
  dateChantier           DateTime? // exigée à l'entrée en PLANIFIE
  photos                 String             @default("[]") // JSON string[] : chemins relatifs au répertoire d'upload
  notes                  DossierNote[]
  evenements             DossierEvenement[]
  documents              Document[]
  archiveLe              DateTime? // archivage : rien ne se supprime
  archiveMotif           String?
  ecriture               String? // contexte de la dernière écriture (auteur, jeton), lu par le journal

  @@index([etape])
  @@index([prochaineActionDate])
  @@index([clientId])
}

model DossierNote {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  dossierId    String
  dossier      Dossier   @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  etape        String // étape à laquelle la note se rattache
  contenu      String
  archiveLe    DateTime? // archivage : rien ne se supprime
  archiveMotif String?
  ecriture     String? // contexte de la dernière écriture (auteur, jeton), lu par le journal

  @@index([dossierId, etape])
}

model DossierEvenement {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  dossierId String
  dossier   Dossier  @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  type      String // TypeEvenement : MAIL_RECU | MAIL_ENVOYE | WHATSAPP_RECU | WHATSAPP_ENVOYE | APPEL | DEVIS_GENERE | DEVIS_ENVOYE | FACTURE_GENEREE | CHANGEMENT_ETAPE | NOTE_AJOUTEE
  direction String // ENTRANT | SORTANT | INTERNE
  contenu   String
  metadata  String   @default("{}") // JSON libre selon le type (ex. { de, vers } pour un changement d'étape)
  ecriture  String? // contexte de la dernière écriture (auteur, jeton), lu par le journal

  @@index([dossierId, createdAt])
}

model Document {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  dossierId    String
  dossier      Dossier   @relation(fields: [dossierId], references: [id], onDelete: Restrict)
  type         String // TypeDocument : DEVIS | FACTURE
  numero       String? // attribué à la génération, jamais réutilisé (voir NUMEROTATION) ; null tant que BROUILLON
  dateEmission DateTime? // fixée à la génération, avec le numéro
  objet        String
  lignes       String // JSON LigneDocument[] : prestations et lignes de section
  totalHt      Float
  acomptePct   Int? // 30 par défaut sur un devis, null sur une facture
  noteMl       Boolean   @default(true)
  pdfPath      String?
  statut       String    @default("BROUILLON") // StatutDocument : BROUILLON | GENERE | ENVOYE | ACCEPTE | REFUSE
  archiveLe    DateTime? // archivage : rien ne se supprime
  archiveMotif String?
  ecriture     String? // contexte de la dernière écriture (auteur, jeton), lu par le journal

  @@unique([type, numero])
  @@index([dossierId])
}

model CompteurNumerotation {
  serie    String // compteur (voir NUMEROTATION) : DEVIS | FACTURE
  annee    Int
  valeur   Int // dernier numéro attribué
  ecriture String? // contexte de la dernière écriture (auteur, jeton), lu par le journal

  @@id([serie, annee])
}

model PresetTarif {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  designation  String
  unite        String // ml | jour | forfait
  prixUnitaire Float? // null = à saisir à chaque devis (carburant, péage, mission)
  ordre        Int       @default(0)
  actif        Boolean   @default(true)
  archiveLe    DateTime? // archivage : rien ne se supprime
  archiveMotif String?
  ecriture     String? // contexte de la dernière écriture (auteur, jeton), lu par le journal
}

// ─────────────────────────────────────────────
// Journal des modifications (traçabilité intégrale)
// Alimenté uniquement par des déclencheurs SQLite générés depuis ce schéma
// (src/lib/journal/declencheurs.ts) : aucune écriture ne peut lui échapper.
// Ni modifiable (sauf caviardage RGPD) ni supprimable.
// ─────────────────────────────────────────────

model JournalModification {
  id               String    @id
  horodatage       DateTime
  modele           String // nom du modèle Prisma
  enregistrementId String
  operation        String // ETAT_INITIAL | CREATION | MODIFICATION | ARCHIVAGE | RESTAURATION
  acteur           String // TYPE:identifiant (voir src/lib/journal/contexte.ts) : HUMAIN, AGENT, SYSTEME, EXTERNE, SCRIPT, MIGRATION, INCONNU
  jeton            String? // identifiant de l'écriture logique (partagé par ses écritures imbriquées)
  origine          String? // route ou tâche à l'origine de l'écriture
  requete          String? // identifiant de la requête HTTP ou de la tâche : regroupe les écritures d'un même geste
  avant            String? // JSON de l'enregistrement avant (null pour une création)
  apres            String // JSON de l'enregistrement après
  caviardeLe       DateTime? // anonymisation RGPD : contenu remplacé, la trace de l'écriture reste

  @@index([modele, enregistrementId, horodatage])
  @@index([horodatage])
  @@index([acteur])
  @@index([requete])
}

// Migrations de données exécutées au démarrage (idempotentes, une seule fois chacune).
model MigrationDonnees {
  nom        String   @id
  executeeLe DateTime
  dureeMs    Int
  resume     String // JSON : compteurs de la migration
  ecriture   String? // contexte de la dernière écriture (auteur, jeton), lu par le journal
}

// ─────────────────────────────────────────────
// File de tâches de fond (src/lib/taches)
// Travail asynchrone et rejouable : miroir Drive, envois validés, relève des
// mails… Jamais dans le chemin d'une requête : l'interface ne l'attend pas.
// Hors journal (mécanique interne) ; ses effets, eux, sont journalisés.
// ─────────────────────────────────────────────

model Tache {
  id              String    @id @default(cuid())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  type            String // TypeTache (src/lib/taches/registre.ts)
  cle             String    @unique // idempotence : deux mises en file de la même clé = une seule tâche
  charge          String    @default("{}") // JSON : paramètres de la tâche
  statut          String    @default("EN_ATTENTE") // EN_ATTENTE | EN_COURS | TERMINEE | ECHEC_DEFINITIF | ANNULEE
  priorite        Int       @default(0) // plus grand = plus urgent
  tentatives      Int       @default(0)
  tentativesMax   Int       @default(8)
  prochainEssaiLe DateTime  @default(now())
  verrouJusqua    DateTime? // bail d'exécution : passé ce délai, une tâche EN_COURS est reprise
  aRejouer        Boolean   @default(false) // remise en file pendant son exécution : rejouer une fois finie
  commenceLe      DateTime?
  termineLe       DateTime?
  derniereErreur  String?
  resultat        String? // JSON rendu par le traitement
  demandeePar     String // acteur qui a mis la tâche en file
  ecriture        String? // contexte de la dernière écriture (auteur, jeton), lu par le journal

  @@index([statut, prochainEssaiLe])
  @@index([type, statut])
}

// Travaux périodiques (relève des mails, vérification du miroir, alertes…) :
// une ligne par travail, son dernier passage et ses échecs consécutifs.
model Planification {
  nom               String    @id
  actif             Boolean   @default(true)
  dernierDebut      DateTime?
  dernierFin        DateTime?
  dernierStatut     String? // SUCCES | ECHEC | IGNORE
  derniereErreur    String?
  echecsConsecutifs Int       @default(0)
  prochainPassage   DateTime  @default(now())
  ecriture          String? // contexte de la dernière écriture (auteur, jeton), lu par le journal
}

// ─────────────────────────────────────────────
// Validation : « l'agent propose, je valide » (src/lib/validation)
// Toute action proposée par un agent ou par le système (rattacher un mail,
// changer une étape, envoyer un devis, fusionner deux clients…) passe par une
// proposition. Rien de ce qui engage de l'argent ou part chez un client ne
// s'exécute sans décision humaine.
// ─────────────────────────────────────────────

model Proposition {
  id               String    @id @default(cuid())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  type             String // TypeProposition (src/lib/validation/types.ts)
  statut           String    @default("EN_ATTENTE") // EN_ATTENTE | VALIDEE (exécution en file) | EXECUTEE | ECHEC | REJETEE | EXPIREE | ANNULEE | AUTOMATIQUE
  auteur           String // acteur qui propose : AGENT:mail, SYSTEME:doublons, SYSTEME:relances…
  titre            String // une phrase lisible : « Rattacher le mail de M. Durand au dossier Cuisine Pérols »
  resume           String? // détail lisible
  raisonnement     String? // pourquoi : conservé tel que formulé par l'agent
  confiance        Float? // 0 à 1, calculée par le code (jamais déclarée par le modèle seul)
  contenu          String // JSON : la proposition telle que faite, jamais modifiée
  contenuValide    String? // JSON : ce qui a été exécuté (la version modifiée, le cas échéant)
  modifiee         Boolean   @default(false) // la personne a corrigé la proposition avant de la valider
  cleUnicite       String?   @unique // une même chose n'est proposée qu'une fois, rejetée ou non
  clientId         String?
  dossierId        String?
  messageId        String?
  expireLe         DateTime?
  decideLe         DateTime?
  decidePar        String? // HUMAIN:email, ou l'acteur d'une exécution automatique autorisée
  motifRejet       String? // code de MOTIFS_REJET
  commentaireRejet String?
  executeLe        DateTime?
  resultat         String? // JSON rendu par l'exécution
  erreurExecution  String?
  archiveLe        DateTime? // archivage : rien ne se supprime
  archiveMotif     String?
  ecriture         String? // contexte de la dernière écriture (auteur, jeton), lu par le journal

  @@index([statut, type])
  @@index([dossierId])
  @@index([clientId])
  @@index([messageId])
}

// ─────────────────────────────────────────────
// Clients pérennes (src/lib/clients)
// Une personne ou une entreprise, au-delà d'un lead ou d'un dossier : son
// historique, ses dossiers, d'où elle vient, qui l'a recommandée.
// ─────────────────────────────────────────────

model Client {
  id                 String             @id @default(cuid())
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  categorie          String             @default("PARTICULIER") // CategorieClient : PARTICULIER | PROFESSIONNEL | DONNEUR_ORDRE
  nom                String // nom d'affichage : « Alice Durand », « Hôtel du Parc »
  prenom             String?
  nomFamille         String?
  raisonSociale      String?
  siret              String?
  adresse            String?
  codePostal         String?
  ville              String?
  // Acquisition : d'où vient le client (posée au premier contact, corrigeable)
  source             String // SourceClient (src/lib/clients/constantes.ts)
  sourceDetail       String? // précision : « salon Habitat », « Instagram »…
  campagne           String?
  publicite          String?
  formulaire         String?
  premierContactLe   DateTime
  recommandeParId    String?
  recommandePar      Client?            @relation("Recommandations", fields: [recommandeParId], references: [id], onDelete: Restrict)
  recommandations    Client[]           @relation("Recommandations")
  recommandeParTexte String? // recommandé par quelqu'un qui n'est pas (encore) client
  fusionneDansId     String? // absorbé par une fusion validée : le client conservé
  notes              String? // passif, contexte durable
  anonymiseLe        DateTime? // RGPD : identité retirée, données comptables conservées
  emails             ClientEmail[]
  telephones         ClientTelephone[]
  consentements      ConsentementMail[]
  leads              Lead[]
  prospects          Prospect[]
  dossiers           Dossier[]
  archiveLe          DateTime? // archivage : rien ne se supprime
  archiveMotif       String?
  ecriture           String? // contexte de la dernière écriture (auteur, jeton), lu par le journal

  @@index([nom])
  @@index([source])
  @@index([recommandeParId])
}

model ClientEmail {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  clientId     String
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  adresse      String // minuscules, sans espaces
  libelle      String? // « pro », « perso », « comptabilité »…
  principale   Boolean   @default(false)
  archiveLe    DateTime? // archivage : rien ne se supprime
  archiveMotif String?
  ecriture     String? // contexte de la dernière écriture (auteur, jeton), lu par le journal

  @@index([adresse])
  @@index([clientId])
}

model ClientTelephone {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  clientId     String
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  numero       String // normalisé : +33612345678
  saisi        String // tel que reçu ou saisi
  libelle      String?
  principal    Boolean   @default(false)
  archiveLe    DateTime? // archivage : rien ne se supprime
  archiveMotif String?
  ecriture     String? // contexte de la dernière écriture (auteur, jeton), lu par le journal

  @@index([numero])
  @@index([clientId])
}

// Consentement aux mails commerciaux : une ligne par déclaration, jamais
// modifiée (la base le refuse). L'état courant est la ligne la plus récente.
model ConsentementMail {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  statut      String // ACCORDE | REFUSE | RETIRE
  recueilliLe DateTime // date où la personne a donné ou retiré son accord
  moyen       String // FORMULAIRE_SITE | META_ADS | ORAL | ECRIT | EMAIL | AUTRE
  preuve      String? // texte de la case cochée, référence du formulaire, du mail…
  ecriture    String? // contexte de la dernière écriture (auteur, jeton), lu par le journal

  @@index([clientId, recueilliLe])
}
